{#
  ============================================================================
  MEDIA LIBRARY STACK - managed by Ansible role: media_library
  Do not edit on the Pi; changes are overwritten on the next deploy.
  ============================================================================

  This is the half of the media stack that must work with no internet at all.
  Jellyfin and Audiobookshelf serve from local disk and need nothing upstream.
  Seerr needs TMDB to browse, so with no uplink it degrades to showing what is
  already requested - the queue still drains later when the *arrs get a
  connection.

  Same design rules as the acquisition stack: no published ports, one /data
  mount, pinned images, every container capped.
#}
{% set m = media_library %}
{% set svc = m.services %}
{% set tz = frey.timezone %}
{% set appdata = media.appdata_dir %}

{% macro logging() %}
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
{%- endmacro %}

{#
  A router can answer on several hostnames. Renaming a service's hostname
  silently breaks every bookmark and habit pointing at the old one, so the
  service-name hostname is always kept and friendlier names are added
  alongside it rather than instead of it.

  Several hostnames must be separate Host() rules joined by ||, NOT
  Host(`a`, `b`). Traefik's Host matcher takes exactly one parameter and
  rejects the comma form with "unexpected number of parameters; got 2,
  expected one of [1]" - and a rule that fails to parse makes Traefik drop
  the router entirely, so the service 404s with the container perfectly
  healthy.

  Three routers per service, and which three depends on one thing: whether the
  service is listed as forward_auth in inventory/group_vars/all/identity.yml.

    <name>          canonical, HTTPS, on <name>.{{ frey.service_domain }}
    <name>-legacy   HTTPS on the old <name>.{{ frey.local_domain }}, redirects
    <name>-http     plain HTTP on BOTH names

  The domain gained a label because single sign-on needs a cookie domain
  containing a period - see frey.service_domain in
  inventory/group_vars/all/main.yml. The legacy router is what stops that from
  breaking every bookmark.

  What <name>-http does is the interesting part:

    protected      it redirects to the canonical HTTPS URL. It has no choice -
                   Authelia's session cookie is Secure, so a forward-auth
                   service answering over HTTP would authenticate and then
                   redirect to the login page forever.

    not protected  it serves the service directly, exactly as before. This is
                   what keeps a smart TV talking to Jellyfin: a television
                   cannot install a private root certificate and gives you no
                   way to click through, so HTTPS-only would not warn, it would
                   simply stop working.

  `authelia@file` on the canonical router is the whole SSO integration. Traefik
  asks Authelia before the request arrives; the service needs no plugin, no
  setting, and no awareness that any of this exists.

  With identity not deployed, identity_protect is empty, nothing is protected,
  and every service keeps answering plain HTTP as it does today.
#}
{% macro proxy_labels(route, name, port, aliases=[], network=frey.proxy_network) %}
{% set canonical = [] %}
{% set legacy = [] %}
{% set every = [] %}
{% for h in [route] + aliases %}
{% set _ = canonical.append('Host(`' ~ h ~ '.' ~ frey.service_domain ~ '`)') %}
{% set _ = legacy.append('Host(`' ~ h ~ '.' ~ frey.local_domain ~ '`)') %}
{% set _ = every.append('Host(`' ~ h ~ '.' ~ frey.service_domain ~ '`)') %}
{% set _ = every.append('Host(`' ~ h ~ '.' ~ frey.local_domain ~ '`)') %}
{% endfor %}
{% set protected = route in (identity_protect | default([])) %}
{% set middlewares = ['secure-headers@file'] + (['drop-remote-user@file'] if name == 'navidrome' else []) + (['authelia@file'] if protected else []) %}
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network={{ network }}"
      - "traefik.http.services.{{ name }}.loadbalancer.server.port={{ port }}"
      - "traefik.http.routers.{{ name }}.rule={{ canonical | join(' || ') }}"
      - "traefik.http.routers.{{ name }}.entrypoints=websecure"
      - "traefik.http.routers.{{ name }}.tls=true"
      - "traefik.http.routers.{{ name }}.middlewares={{ middlewares | join(',') }}"
      - "traefik.http.routers.{{ name }}-legacy.rule={{ legacy | join(' || ') }}"
      - "traefik.http.routers.{{ name }}-legacy.entrypoints=websecure"
      - "traefik.http.routers.{{ name }}-legacy.tls=true"
      - "traefik.http.routers.{{ name }}-legacy.middlewares=to-canonical@file"
      - "traefik.http.routers.{{ name }}-legacy.service={{ name }}"
      - "traefik.http.routers.{{ name }}-http.rule={{ every | join(' || ') }}"
      - "traefik.http.routers.{{ name }}-http.entrypoints=web"
      - "traefik.http.routers.{{ name }}-http.service={{ name }}"
{% if protected %}
      - "traefik.http.routers.{{ name }}-http.middlewares=to-canonical@file"
{% else %}
      - "traefik.http.routers.{{ name }}-http.middlewares=secure-headers@file"
{% endif %}
      - "frey.module=media_library"
{%- endmacro %}

networks:
  {{ frey.proxy_network }}:
    external: true
  {{ media.network.name }}:
    external: true
  {{ frey.navidrome_network.name }}:
    external: true

services:
{% if svc.jellyfin.enabled | bool %}
  jellyfin:
    image: {{ svc.jellyfin.image }}
    container_name: {{ svc.jellyfin.container_name }}
    hostname: {{ svc.jellyfin.hostname }}
    restart: unless-stopped
    environment:
      - PUID={{ media.user.uid }}
      - PGID={{ media.user.gid }}
      - TZ={{ tz }}
      # Tells Jellyfin which URL to advertise to clients for direct
      # connections, so apps that follow it do not try to reach a container IP.
      # HTTPS and the canonical domain: an OIDC redirect back to an http:// URL
      # is refused outright for a public client, which this is.
      - JELLYFIN_PublishedServerUrl=https://jellyfin.{{ frey.service_domain }}
      # Transcoding is software-only on a Pi 5; keep the scratch dir on NVMe.
      - JELLYFIN_FFmpeg__probesize=1G
    volumes:
      - "{{ appdata }}/jellyfin:/config"
      # Read-only: Jellyfin plays, the *arrs write. Nothing here should be
      # able to delete the library.
      - "{{ media.data_dir }}/media:/data/media:ro"
      - "{{ svc.jellyfin.transcode_dir }}:/transcodes"
{% if (identity_services | default({})).get('jellyfin', {}).get('auth', 'none') == 'oidc' %}
      # The SSO plugin calls https://auth.{{ frey.service_domain }} from inside
      # this container - fetching discovery, exchanging the code for a token -
      # and those calls use the container's trust store, not a browser's. The
      # linuxserver image runs anything in /custom-cont-init.d as root before
      # Jellyfin starts, which is where the CA gets installed.
      - "{{ frey.pki_public_dir }}/frey-root-ca.crt:/frey-ca.crt:ro"
      - "{{ frey.pki_public_dir }}/container-init:/custom-cont-init.d:ro"
{% endif %}
    networks:
      - {{ frey.proxy_network }}
      - {{ media.network.name }}
{% if svc.jellyfin.devices | length > 0 %}
    devices:
{% for device in svc.jellyfin.devices %}
      - "{{ device }}"
{% endfor %}
{% endif %}
{{ proxy_labels('jellyfin', 'jellyfin', svc.jellyfin.port) }}
    mem_limit: {{ svc.jellyfin.mem_limit }}
    cpus: "{{ svc.jellyfin.cpus }}"
    pids_limit: 512
    security_opt:
      - no-new-privileges:true
{{ logging() }}
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://localhost:{{ svc.jellyfin.port }}/health || exit 1"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 180s

{% endif %}
{% if svc.navidrome.enabled | bool %}
  navidrome:
    image: {{ svc.navidrome.image }}
    container_name: {{ svc.navidrome.container_name }}
    hostname: {{ svc.navidrome.hostname }}
    user: "{{ media.user.uid }}:{{ media.user.gid }}"
    restart: unless-stopped
    environment:
      - TZ={{ tz }}
      - ND_EXTAUTH_TRUSTEDSOURCES={{ frey.navidrome_network.traefik_ip }}/32
      - ND_ENABLEUSEREDITING=false
    volumes:
      - "{{ appdata }}/navidrome:/data"
      - "{{ media.data_dir }}/media/music:/music:ro"
    # Keep Docker from dynamically assigning Traefik's trusted address after reboot.
    networks:
      {{ frey.navidrome_network.name }}:
        ipv4_address: {{ frey.navidrome_network.navidrome_ip }}
{{ proxy_labels('navidrome', 'navidrome', svc.navidrome.port, network=frey.navidrome_network.name) }}
    mem_limit: {{ svc.navidrome.mem_limit }}
    cpus: "{{ svc.navidrome.cpus }}"
    pids_limit: 256
    security_opt:
      - no-new-privileges:true
{{ logging() }}

{% endif %}
{% if svc.audiobookshelf.enabled | bool %}
  audiobookshelf:
    image: {{ svc.audiobookshelf.image }}
    container_name: {{ svc.audiobookshelf.container_name }}
    hostname: {{ svc.audiobookshelf.hostname }}
    restart: unless-stopped
    environment:
      - TZ={{ tz }}
{% if (identity_services | default({})).get('audiobookshelf', {}).get('auth', 'none') == 'oidc' %}
      # Audiobookshelf is Node, not a linuxserver image, so it has no
      # /custom-cont-init.d hook and never reads the system trust store for
      # outbound TLS. NODE_EXTRA_CA_CERTS is the mechanism it does respect, and
      # without it the OIDC token exchange fails with a bare
      # SELF_SIGNED_CERT_IN_CHAIN that says nothing useful.
      - NODE_EXTRA_CA_CERTS=/frey-ca.crt
{% endif %}
    volumes:
      - "{{ appdata }}/audiobookshelf/config:/config"
      - "{{ appdata }}/audiobookshelf/metadata:/metadata"
{% if (identity_services | default({})).get('audiobookshelf', {}).get('auth', 'none') == 'oidc' %}
      - "{{ frey.pki_public_dir }}/frey-root-ca.crt:/frey-ca.crt:ro"
{% endif %}
      - "{{ media.data_dir }}/media/audiobooks:/audiobooks"
      - "{{ media.data_dir }}/media/podcasts:/podcasts"
    networks:
      - {{ frey.proxy_network }}
      - {{ media.network.name }}
{{ proxy_labels(svc.audiobookshelf.route_host, 'audiobookshelf', svc.audiobookshelf.port, svc.audiobookshelf.route_aliases | default([])) }}
    mem_limit: {{ svc.audiobookshelf.mem_limit }}
    pids_limit: 512
    security_opt:
      - no-new-privileges:true
{{ logging() }}

{% endif %}
{% if svc.seerr.enabled | bool %}
{#
  Seerr, not Jellyseerr. Jellyseerr and Overseerr were merged upstream into
  Seerr; Jellyseerr is discontinued and receives no updates or security
  patches, and its Jellyfin authentication breaks against Jellyfin 12's
  reworked auth. Seerr is the continuation of the same project, not a
  different app.
#}
  seerr:
    image: {{ svc.seerr.image }}
    container_name: {{ svc.seerr.container_name }}
    hostname: {{ svc.seerr.hostname }}
    restart: unless-stopped
    # Runs as the media user like the rest of the stack. The image otherwise
    # runs as its own built-in uid, which cannot write into the appdata
    # directory Ansible created - Seerr then crashloops on startup with
    # "EACCES: permission denied, mkdir '/app/config/logs/'".
    user: "{{ media.user.uid }}:{{ media.user.gid }}"
    environment:
      - TZ={{ tz }}
      - LOG_LEVEL=info
    volumes:
      - "{{ appdata }}/seerr:/app/config"
    networks:
      - {{ frey.proxy_network }}
      - {{ media.network.name }}
{{ proxy_labels(svc.seerr.route_host, 'seerr', svc.seerr.port, svc.seerr.route_aliases | default([])) }}
    mem_limit: {{ svc.seerr.mem_limit }}
    pids_limit: 512
    security_opt:
      - no-new-privileges:true
{{ logging() }}

{% endif %}
{% if svc.audiobookrequest.enabled | bool %}
  audiobookrequest:
    image: {{ svc.audiobookrequest.image }}
    container_name: {{ svc.audiobookrequest.container_name }}
    hostname: {{ svc.audiobookrequest.hostname }}
    restart: unless-stopped
    environment:
      - TZ={{ tz }}
      - PUID={{ media.user.uid }}
      - PGID={{ media.user.gid }}
      - ABR_APP__PORT={{ svc.audiobookrequest.port }}
      - ABR_APP__OPENAPI_ENABLED=true
    volumes:
      - "{{ appdata }}/audiobookrequest:/config"
    networks:
      - {{ frey.proxy_network }}
      - {{ media.network.name }}
{{ proxy_labels(svc.audiobookrequest.route_host, 'audiobookrequest', svc.audiobookrequest.port, svc.audiobookrequest.route_aliases | default([])) }}
    mem_limit: {{ svc.audiobookrequest.mem_limit }}
    pids_limit: 256
    security_opt:
      - no-new-privileges:true
{{ logging() }}

{% endif %}
{% if svc.maintainerr.enabled | bool %}
  maintainerr:
    image: {{ svc.maintainerr.image }}
    container_name: {{ svc.maintainerr.container_name }}
    hostname: {{ svc.maintainerr.hostname }}
    restart: unless-stopped
    user: "{{ media.user.uid }}:{{ media.user.gid }}"
    environment:
      - TZ={{ tz }}
    volumes:
      - "{{ appdata }}/maintainerr:/opt/data"
    networks:
      - {{ frey.proxy_network }}
      - {{ media.network.name }}
{{ proxy_labels('maintainerr', 'maintainerr', svc.maintainerr.port) }}
    mem_limit: {{ svc.maintainerr.mem_limit }}
    pids_limit: 256
    security_opt:
      - no-new-privileges:true
{{ logging() }}

{% endif %}
{% if svc.jellystat.enabled | bool and svc.jellystat_db.enabled | bool %}
  jellystat-db:
    image: {{ svc.jellystat_db.image }}
    container_name: {{ svc.jellystat_db.container_name }}
    hostname: {{ svc.jellystat_db.hostname }}
    restart: unless-stopped
    environment:
      - TZ={{ tz }}
      - POSTGRES_DB={{ svc.jellystat_db.database }}
      - POSTGRES_USER={{ svc.jellystat_db.username }}
      - POSTGRES_PASSWORD={{ media_secrets.jellystat_postgres_password }}
    volumes:
      # PostgreSQL 18+ wants a SINGLE mount at /var/lib/postgresql and puts
      # the cluster in a versioned subdirectory itself, so that a later
      # `pg_upgrade --link` does not cross a mount boundary. Mounting
      # /var/lib/postgresql/data instead - correct for 17 and earlier - makes
      # 18 refuse to start: it initialises a cluster elsewhere and then
      # reports the mount as "unused mount/volume".
      - "{{ appdata }}/jellystat/db:/var/lib/postgresql"
    networks:
      # Database only - never on the proxy network. Nothing outside this
      # stack has any business reaching it.
      - {{ media.network.name }}
    labels:
      - "traefik.enable=false"
      - "frey.module=media_library"
    mem_limit: {{ svc.jellystat_db.mem_limit }}
    shm_size: {{ svc.jellystat_db.shm_size }}
    pids_limit: 256
    security_opt:
      - no-new-privileges:true
{{ logging() }}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready --dbname={{ svc.jellystat_db.database }} --username={{ svc.jellystat_db.username }}"]
      interval: 30s
      timeout: 10s
      retries: 5

  jellystat:
    image: {{ svc.jellystat.image }}
    container_name: {{ svc.jellystat.container_name }}
    hostname: {{ svc.jellystat.hostname }}
    restart: unless-stopped
    environment:
      - TZ={{ tz }}
      - POSTGRES_DB={{ svc.jellystat_db.database }}
      - POSTGRES_USER={{ svc.jellystat_db.username }}
      - POSTGRES_PASSWORD={{ media_secrets.jellystat_postgres_password }}
      - POSTGRES_IP={{ svc.jellystat_db.hostname }}
      - POSTGRES_PORT=5432
      - JWT_SECRET={{ media_secrets.jellystat_jwt_secret }}
    volumes:
      - "{{ appdata }}/jellystat/backup:/app/backend/backup-data"
    networks:
      - {{ frey.proxy_network }}
      - {{ media.network.name }}
    depends_on:
      jellystat-db:
        condition: service_healthy
{{ proxy_labels('jellystat', 'jellystat', svc.jellystat.port) }}
    mem_limit: {{ svc.jellystat.mem_limit }}
    pids_limit: 256
    security_opt:
      - no-new-privileges:true
{{ logging() }}

{% endif %}
