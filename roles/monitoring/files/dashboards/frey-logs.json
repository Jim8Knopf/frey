{
  "uid": "frey-logs",
  "title": "Frey Logs",
  "description": "Everything the Pi logged, filterable by Frey module, container and level. Start from the volume histogram, not the log river.",
  "tags": ["frey", "logs"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "",
  "graphTooltip": 1,
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "module",
        "label": "Frey module",
        "type": "query",
        "datasource": { "type": "loki", "uid": "frey-loki" },
        "query": { "label": "frey_module", "refId": "LokiVariableQueryEditor-VariableQuery", "type": 1 },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": { "type": "loki", "uid": "frey-loki" },
        "query": { "label": "container", "refId": "LokiVariableQueryEditor-VariableQuery", "type": 1 },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "query": "error,warn,info,debug",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "search",
        "label": "Contains",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Log volume by level",
      "description": "The fastest way to see 'something started erroring at 03:12'. Read this first; the log river below is for after you know where to look.",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "frey-loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (level) (count_over_time({job=~\"docker|journal\"} | __error__=\"\" [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{level}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "error" },
            "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ]
          },
          {
            "matcher": { "id": "byName", "options": "warn" },
            "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "Noisiest containers",
      "description": "Log volume is a real cost on an NVMe that also holds the databases and the library. This is where a newly chatty container shows up.",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 7 },
      "datasource": { "type": "loki", "uid": "frey-loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (container) (count_over_time({job=\"docker\"} [$__auto])))",
          "queryType": "range",
          "legendFormat": "{{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["sum"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "logs",
      "title": "Container logs",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 14 },
      "datasource": { "type": "loki", "uid": "frey-loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"docker\", frey_module=~\"$module\", container=~\"$container\"} | level =~ \"$level\" |~ \"(?i)$search\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "exact",
        "sortOrder": "Descending"
      }
    },
    {
      "type": "logs",
      "title": "System journal",
      "description": "systemd, the kernel, NetworkManager, dnsmasq. The half that explains an unreachable Pi with a perfectly healthy container stack.",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 28 },
      "datasource": { "type": "loki", "uid": "frey-loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"journal\"} |~ \"(?i)$search\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "exact",
        "sortOrder": "Descending"
      }
    }
  ]
}
