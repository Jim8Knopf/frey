# Managed by Ansible role: monitoring. Do not edit on the Pi.
[Unit]
Description=Frey container log repair timer
Documentation=file://{{ monitoring.bin_dir }}/frey-log-repair

[Timer]
# The damage is done by an unclean shutdown, so the run that matters is the one
# just after boot - before Alloy has had time to wedge its tailers against a
# hole that is already there. Everything after that is a safety net.
OnBootSec=45s
OnUnitActiveSec={{ monitoring.log_repair.interval }}
AccuracySec=10s
RandomizedDelaySec=5s
Unit={{ monitoring.log_repair.service_name }}.service
# A missed run is not worth catching up on: the next one does the same work,
# and a repair that fires during a boot storm competes with the stack starting.
Persistent=false

[Install]
WantedBy=timers.target
