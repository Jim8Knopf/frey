{#
  ============================================================================
  HOST ALERT RULES - managed by Ansible role: monitoring
  Do not edit on the Pi; changes are overwritten on the next deploy.
  ============================================================================

  Generated from monitoring_thresholds in
  inventory/group_vars/all/monitoring.yml. Change a number there, not here.

  `go`/`og` stand in for Go template braces, the same trick
  roles/identity/templates/authelia-configuration.yml.j2 uses: Prometheus
  annotations are Go templates and Jinja would otherwise eat them.
#}
{% set go = '{{' %}
{% set og = '}}' %}
{% set t = monitoring_thresholds %}
{% set root = '/' %}
groups:

  # ============================================================================
  # DISK
  #
  # One filesystem matters on this Pi: / on the NVMe, which holds the Docker
  # data root, every database and the whole media library. Everything else is
  # tmpfs and overlay noise, excluded at the collector.
  # ============================================================================
  - name: frey_disk
    rules:

      - alert: FreyDiskCritical
        expr: >-
          100 * node_filesystem_avail_bytes{fstype!~"tmpfs|overlay|squashfs"}
          / node_filesystem_size_bytes{fstype!~"tmpfs|overlay|squashfs"}
          < {{ t.disk.critical_percent }}
        for: {{ t.disk.for_critical }}
        labels:
          severity: critical
        annotations:
          summary: 'Disk {{ go }} $labels.mountpoint {{ og }} almost full ({{ go }} printf "%.1f" $value {{ og }}% free)'
          description: >-
            Under {{ t.disk.critical_percent }}% left. At this point Docker
            cannot write, the *arr and Jellyfin SQLite databases risk
            corruption on their next write, and qBittorrent will start
            erroring on every active torrent.
            Fastest wins: pause downloading, then look at
            {{ media.data_dir }}/downloads for imports that never completed.

      - alert: FreyDiskLow
        expr: >-
          100 * node_filesystem_avail_bytes{fstype!~"tmpfs|overlay|squashfs"}
          / node_filesystem_size_bytes{fstype!~"tmpfs|overlay|squashfs"}
          < {{ t.disk.low_percent }}
        for: {{ t.disk.for_warning }}
        labels:
          severity: warning
        annotations:
          summary: 'Disk {{ go }} $labels.mountpoint {{ og }} at {{ go }} printf "%.1f" $value {{ og }}% free'
          description: >-
            Below {{ t.disk.low_percent }}% free. Worth clearing now rather
            than at {{ t.disk.critical_percent }}%, when the databases are
            already at risk.

      # ------------------------------------------------------------------------
      # THE PROACTIVE ONE
      #
      # Everything above tells you the disk IS full. This tells you it is
      # GOING to be, while there is still time to do something unhurried about
      # it. On a 4 TB disk filling steadily, this fires weeks before the
      # others - which is the whole point of monitoring rather than checking.
      #
      # Gated on being under 30% already, because predict_linear on a mostly
      # empty disk extrapolates ordinary noise into nonsense.
      # ------------------------------------------------------------------------
      - alert: FreyDiskFillingUp
        expr: >-
          predict_linear(
            node_filesystem_avail_bytes{fstype!~"tmpfs|overlay|squashfs"}[{{ t.disk.predict_window }}],
            {{ t.disk.predict_full_days }} * 24 * 3600
          ) < 0
          and
          node_filesystem_avail_bytes{fstype!~"tmpfs|overlay|squashfs"}
          / node_filesystem_size_bytes{fstype!~"tmpfs|overlay|squashfs"} < 0.3
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: '{{ go }} $labels.mountpoint {{ og }} will be full within {{ t.disk.predict_full_days }} days'
          description: >-
            Based on the last {{ t.disk.predict_window }} of growth. Nothing is
            broken yet - this is the warning that lets you deal with it on a
            good uplink instead of in a hurry.

      # A read-only root is how a dying NVMe announces itself: the kernel
      # remounts to protect the data. Everything will misbehave from here, and
      # no amount of restarting containers will help.
      - alert: FreyRootFilesystemReadOnly
        expr: frey_rootfs_readonly == 1
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "Root filesystem has gone read-only"
          description: >-
            The kernel remounted / read-only, which almost always means the
            NVMe is failing or has thrown an I/O error. Nothing will write
            until this is resolved. Check `dmesg -T | tail -50` and
            `nvme smart-log /dev/nvme0` before rebooting - a reboot may not
            come back.

  # ============================================================================
  # MEMORY AND CPU
  # ============================================================================
  - name: frey_resources
    rules:

      - alert: FreyMemoryCritical
        expr: >-
          100 * node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes
          < {{ t.memory.critical_percent }}
        for: {{ t.memory.for_critical }}
        labels:
          severity: critical
        annotations:
          summary: 'Memory almost gone ({{ go }} printf "%.1f" $value {{ og }}% available)'
          description: >-
            Under {{ t.memory.critical_percent }}% available. The kernel is
            about to start OOM-killing, and it does not pick politely - it may
            take hostapd or dnsmasq, which means losing FreyHub itself.

      - alert: FreyMemoryLow
        expr: >-
          100 * node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes
          < {{ t.memory.low_percent }}
        for: {{ t.memory.for_warning }}
        labels:
          severity: warning
        annotations:
          summary: 'Memory down to {{ go }} printf "%.1f" $value {{ og }}% available'
          description: >-
            Below {{ t.memory.low_percent }}% available. On 16 GB that is
            unusual and worth understanding - check the containers panel for
            which one grew.

      - alert: FreyOomKill
        expr: increase(node_vmstat_oom_kill[15m]) > 0
        for: 0m
        labels:
          severity: critical
        annotations:
          summary: "The kernel OOM-killed a process"
          description: >-
            Something was killed to reclaim memory. Find out what before it
            happens again: `journalctl -k --since '-30m' | grep -i oom`. If it
            took a gateway process, FreyHub may be degraded without the
            container checks noticing.

      - alert: FreyLoadHigh
        expr: >-
          node_load15
          / on(instance) group_left
          count by (instance) (count by (instance, cpu) (node_cpu_seconds_total))
          > {{ t.cpu.load_per_core_warning }}
        for: {{ t.cpu.for_warning }}
        labels:
          severity: warning
        annotations:
          summary: 'Sustained load {{ go }} printf "%.1f" $value {{ og }} per core'
          description: >-
            Load has been above {{ t.cpu.load_per_core_warning }} per core for
            {{ t.cpu.for_warning }}. The usual cause here is a Jellyfin
            software transcode - the Pi 5 has no hardware encoder, so every
            transcode competes with the gateway. Check what is playing before
            blaming anything else.

  # ============================================================================
  # TEMPERATURE, POWER AND THROTTLING
  #
  # The van-specific group, and the most valuable one here. The Pi 5 reports
  # under-voltage and throttling directly, and in a vehicle those are not
  # theoretical: they mean the supply is sagging or the cabin is too hot.
  # Neither shows up anywhere else until something is already corrupted.
  # ============================================================================
  - name: frey_thermal_power
    rules:

      - alert: FreySocTempCritical
        expr: frey_soc_temp_celsius > {{ t.temperature.soc_critical }}
        for: {{ t.temperature.for_critical }}
        labels:
          severity: critical
        annotations:
          summary: 'SoC at {{ go }} printf "%.1f" $value {{ og }} C'
          description: >-
            Above {{ t.temperature.soc_critical }} C. The Pi 5 soft-throttles
            at 80 and hard-throttles at 85, so performance is already going.
            Improve airflow, get it out of direct sun, or stop whatever is
            transcoding.

      - alert: FreySocTempWarning
        expr: frey_soc_temp_celsius > {{ t.temperature.soc_warning }}
        for: {{ t.temperature.for_warning }}
        labels:
          severity: warning
        annotations:
          summary: 'SoC running warm at {{ go }} printf "%.1f" $value {{ og }} C'
          description: >-
            Above {{ t.temperature.soc_warning }} C for
            {{ t.temperature.for_warning }}. Not throttling yet - this is the
            window in which moving the airflow is easy.

      # --------------------------------------------------------------------------
      # UNDER-VOLTAGE: the single most useful alert on this list for a van.
      #
      # It means the 5 V supply is sagging under load - a tired DC-DC
      # converter, a thin or long cable, a leisure battery going flat. Left
      # alone it corrupts filesystems, and it is the most likely cause of an
      # NVMe that mysteriously develops errors.
      #
      # Critical after one minute rather than the usual grace period: by the
      # time this is sustained, writes have already been happening at a voltage
      # the flash was not promised.
      # --------------------------------------------------------------------------
      - alert: FreyUndervoltage
        expr: frey_undervoltage_now == 1
        for: {{ t.power.undervoltage_for }}
        labels:
          severity: critical
        annotations:
          summary: "Under-voltage detected - the Pi's supply is sagging"
          description: >-
            The Pi reports the 5 V rail below spec right now. This corrupts
            filesystems and is a common cause of unexplained NVMe errors.
            Check the supply, the cable and the battery state of charge before
            anything else - no software change fixes this.

      - alert: FreyUndervoltageOccurred
        expr: frey_undervoltage_occurred == 1 and frey_undervoltage_now == 0
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Under-voltage happened since boot"
          description: >-
            Not happening now, but it has since the last boot - so it is
            intermittent, which is worse to diagnose later than now. Usually
            the supply sagging under a load peak. Clears on reboot.

      - alert: FreyThrottling
        expr: frey_throttled_now == 1 or frey_freq_capped_now == 1
        for: {{ t.power.throttling_for }}
        labels:
          severity: warning
        annotations:
          summary: "The Pi is throttling"
          description: >-
            The clock is being capped, from heat or from voltage. Check
            temperature and under-voltage together - if both look fine, the
            supply is the suspect.

      # ----------------------------------------------------------------------
      # THE RAIL ITSELF, BEFORE THE FLAG TRIPS
      #
      # frey_undervoltage_now is the Pi admitting the supply has ALREADY gone
      # out of spec. These two watch the measured EXT5V rail instead, so a
      # sagging supply shows up on the way down - the difference between
      # "do something about the power now" and "find out afterwards from the
      # unsafe-shutdown counter".
      # ----------------------------------------------------------------------
      - alert: Frey5vRailCritical
        expr: frey_pmic_rail_volts{rail="EXT5V"} < {{ t.power.rail_5v_critical }}
        for: {{ t.power.rail_5v_for }}
        labels:
          severity: critical
        annotations:
          summary: '5V rail down to {{ go }} printf "%.2f" $value {{ og }}V'
          description: >-
            Below {{ t.power.rail_5v_critical }}V, which is where the Pi starts
            flagging under-voltage. Writes are happening at a voltage the flash
            was never promised. This is the state that precedes an unclean
            shutdown and a corrupted database - deal with the supply now.

      - alert: Frey5vRailLow
        expr: frey_pmic_rail_volts{rail="EXT5V"} < {{ t.power.rail_5v_warning }}
        for: {{ t.power.rail_5v_for }}
        labels:
          severity: warning
        annotations:
          summary: '5V rail sagging at {{ go }} printf "%.2f" $value {{ og }}V'
          description: >-
            Nominal is 5.1V and this Pi normally idles near 5.16V, so below
            {{ t.power.rail_5v_warning }}V means the supply is under strain -
            a tired converter, a thin or long cable, or a battery going flat.
            Nothing is broken yet, which is exactly why you are being told.

  # ============================================================================
  # NVMe HEALTH
  #
  # The drive holds everything: the databases, the media, the OS. It reports
  # its own wear and its own error counts, and the only reason those usually go
  # unnoticed is that nobody reads them. At 0% used today, these thresholds are
  # about having the alarm already wired up years before it matters.
  # ============================================================================
  - name: frey_nvme
    rules:

      # The alert this van actually needed. Every other rule in this group
      # reads the drive's own health, and this drive's health is immaculate -
      # 0% wear, 0 media errors, no critical warning - while it repeatedly
      # falls off the PCIe bus and takes the host down with it. SMART cannot
      # see a link-layer dropout, so without this the failure is invisible to
      # monitoring and gets blamed on whatever was busy at the time.
      #
      # Critical at a single occurrence, deliberately. One recovered reset is
      # a multi-second I/O stall across the whole host - mid-film buffering,
      # an *arr timing out, a database write hanging - and the next one may
      # not be recovered at all. There is no benign version of this.
      # The van's recovery guarantee, asserted rather than assumed. Without
      # both of these an NVMe wedge does not end on its own: systemd keeps
      # petting the hardware watchdog from RAM, so nothing reboots and the Pi
      # waits for a human to cut the power. They are set by rpi_nvme, and they
      # spent two days silently reverted at every boot because they had been
      # written to a file Debian 13 does not read.
      #
      # Warning, not critical: it reports a missing safety net rather than an
      # active fault, and the alert that matters during the fault itself is
      # FreyNvmeControllerReset.
      - alert: FreyWedgeRecoveryDisarmed
        expr: >-
          frey_kernel_hung_task_panic == 0
          or frey_kernel_panic_reboot_secs == 0
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: 'The NVMe wedge self-reboot is not armed'
          description: >-
            kernel.hung_task_panic or kernel.panic is 0, so a task blocked
            forever on a disappeared NVMe will hang the van until someone
            power-cycles it by hand instead of rebooting in about two and a
            half minutes. Check that frey.sysctl_file is landing in
            /etc/sysctl.d/ and not /etc/sysctl.conf, which is not read at
            boot, then re-run `--tags nvme`. Confirm with
            `cat /proc/sys/kernel/hung_task_panic /proc/sys/kernel/panic`.

      # The other half of FreyWedgeRecoveryDisarmed, and the half that was
      # missing on 2026-11-01. hung_task_panic only fires when a task BLOCKS;
      # that outage had the NVMe returning errors instead, so nothing hung,
      # nothing panicked, and the van sat pingable and useless until the power
      # was cut. The ext4 superblock was on `Continue`, which also means ext4
      # keeps writing through a fault.
      - alert: FreyRootFsErrorsNotFatal
        expr: frey_root_fs_error_behaviour < 2
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: 'An NVMe I/O error will not reboot the van'
          description: >-
            The root filesystem is set to carry on (or merely remount
            read-only) when the disk errors, so a fault that returns errors
            rather than blocking will leave the Pi reachable by ping and
            answering nothing - sshd resetting before its banner, Traefik
            404ing every host - until someone cuts the power. `Continue` also
            risks writing through the fault. Re-run `--tags nvme` and reboot;
            the superblock only takes effect at mount. Confirm with
            `sudo tune2fs -l $(findmnt -n -o SOURCE /) | grep 'Errors behavior'`.

      - alert: FreyNvmeControllerReset
        expr: increase(frey_nvme_controller_resets_total[15m]) > 0
        for: 0m
        labels:
          severity: critical
        annotations:
          summary: 'NVMe {{ go }} $labels.device {{ og }} dropped off the PCIe bus'
          description: >-
            The controller left the bus and the kernel reset it. Disk I/O
            stalled for seconds while that happened, which is what buffering
            and random service timeouts look like from the outside - do not go
            looking for a CPU hog. Confirm with `journalctl -k -b | grep -i
            'controller is down'`. If FreyNvmeApstEnabled is also firing the
            cure has not booted yet; otherwise set `pciex1_gen=1`, then
            reseat the NVMe ribbon - it is a van, and that cable moves.

      # Deployment drift that no `0 changed` run can catch. The cmdline file
      # can be correct on disk for weeks while the running kernel still has
      # APST enabled, because the parameter only applies at boot - so the repo
      # says fixed, Ansible says fixed, and the drive goes on sleeping itself
      # off the bus. Read the kernel's live value instead and say so.
      - alert: FreyNvmeApstEnabled
        expr: frey_nvme_apst_max_latency_us != 0
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: 'NVMe APST is enabled - the dropout fix is not live'
          description: >-
            The running kernel allows APST up to {{ go }} $value {{ og }}us,
            so this controller can still be parked in a power state it does
            not reliably wake from. `nvme_core.default_ps_max_latency_us=0` is
            in rpi_nvme's cmdline but a cmdline change needs a reboot to take
            effect. Reboot at a convenient moment; until then expect dropouts.

      - alert: FreyNvmeCriticalWarning
        expr: frey_nvme_critical_warning != 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: 'NVMe {{ go }} $labels.device {{ og }} raised a critical warning'
          description: >-
            The drive itself is reporting a fault - spare blocks exhausted,
            degraded reliability, over temperature or read-only mode. Run
            `nvme smart-log /dev/nvme0` and take a backup before anything
            else.

      - alert: FreyNvmeMediaErrors
        expr: increase(frey_nvme_media_errors_total[1h]) > {{ t.nvme.media_errors }}
        for: 0m
        labels:
          severity: critical
        annotations:
          summary: 'NVMe {{ go }} $labels.device {{ og }} reported media errors'
          description: >-
            Uncorrectable data errors. On a drive holding the only copy of
            anything, one is enough to act on. Check under-voltage too - a
            sagging supply produces these on an otherwise healthy drive.

      - alert: FreyNvmeWearCritical
        expr: frey_nvme_wear_percent > {{ t.nvme.wear_critical_percent }}
        for: 1h
        labels:
          severity: critical
        annotations:
          summary: 'NVMe {{ go }} $labels.device {{ og }} at {{ go }} $value {{ og }}% of rated life'
          description: >-
            Past {{ t.nvme.wear_critical_percent }}% of its endurance rating.
            Plan a replacement. Write volume is dominated by Loki and the
            Prometheus TSDB, so monitoring_enable.logs is the biggest lever if
            you need to slow it down.

      - alert: FreyNvmeWearHigh
        expr: frey_nvme_wear_percent > {{ t.nvme.wear_warning_percent }}
        for: 6h
        labels:
          severity: warning
        annotations:
          summary: 'NVMe {{ go }} $labels.device {{ og }} at {{ go }} $value {{ og }}% of rated life'
          description: >-
            Past {{ t.nvme.wear_warning_percent }}%. Years of warning, not
            days - but worth knowing while a replacement can be bought
            unhurried.

      - alert: FreyNvmeHot
        expr: frey_nvme_temperature_celsius > {{ t.temperature.nvme_warning }}
        for: {{ t.temperature.for_warning }}
        labels:
          severity: warning
        annotations:
          summary: 'NVMe {{ go }} $labels.device {{ og }} at {{ go }} $value {{ og }} C'
          description: >-
            Above {{ t.temperature.nvme_warning }} C. NVMe drives throttle
            themselves when hot, which shows up as everything feeling slow
            with no CPU load to explain it.

      # An unclean shutdown in a van means the power was cut - the ignition,
      # a flat battery, a knocked connector. The drive counts them, and the
      # count is the only durable evidence it happened.
      # CRITICAL, not a warning. This Pi had recorded 12 unsafe shutdowns in
      # 13 hours of total runtime, which is not an occasional mishap - it is
      # the single most likely cause of future database corruption across the
      # *arrs, Jellyfin and LLDAP. It buzzes.
      - alert: FreyUnsafeShutdown
        expr: >-
          increase(frey_nvme_unsafe_shutdowns_total[{{ t.power.unsafe_shutdown_window }}]) > 0
        for: 0m
        labels:
          severity: critical
        annotations:
          summary: "The Pi lost power without shutting down"
          description: >-
            The NVMe recorded an unsafe shutdown, so the Pi was cut off rather
            than halted. Every one risks filesystem and database damage, and
            SQLite is what suffers - the *arr databases, Jellyfin's metadata
            and LLDAP's directory.
            Check the supply, the cable and the battery before anything else.
            No software change prevents this; the fix is a supply that
            outlasts the ignition.

      - alert: FreyUnsafeShutdownsAccumulating
        # A standing reminder rather than an event, and deliberately slow -
        # warnings repeat weekly - so it nags without becoming noise.
        expr: frey_nvme_unsafe_shutdowns_total > 5
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: 'NVMe has recorded {{ go }} $value {{ og }} unclean power losses in total'
          description: >-
            Cumulative, not new. A healthy installation sits at one or two. A
            number that keeps climbing means the Pi is routinely cut off
            rather than shut down, and every count is a chance of silent
            database damage.
            Compare it with power_cycles in `nvme smart-log /dev/nvme0`: if
            the two are close, almost every power-off is unclean.

  # ============================================================================
  # THE HOST GENERALLY
  # ============================================================================
  - name: frey_system
    rules:

      - alert: FreySystemdUnitsFailed
        expr: frey_systemd_units_failed > 0
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: '{{ go }} $value {{ og }} systemd unit(s) in failed state'
          description: >-
            Run `systemctl --failed`. Worth reading even when everything looks
            fine: this is where a failed NAT setup, a dead collector timer or a
            broken deadman rollback shows up.

      - alert: FreyRebooted
        expr: time() - node_boot_time_seconds < 600
        for: 1m
        labels:
          severity: warning
        annotations:
          summary: "The Pi rebooted"
          description: >-
            Up for under ten minutes. If you did not do it deliberately, check
            FreyUnsafeShutdown and FreyUndervoltage - in a van an unexplained
            reboot is usually power, not software.
