{#
  ============================================================================
  SELF-MONITORING ALERT RULES - managed by Ansible role: monitoring
  Do not edit on the Pi; changes are overwritten on the next deploy.
  ============================================================================

  Monitoring that dies quietly is worse than no monitoring, because you believe
  you are covered. Everything in this file exists to make that impossible.

  There are three layers, and each one catches what the layer above cannot:

    1. up == 0 and the collector metrics below. Catches a dead exporter, a
       stalled collector, a failed config reload. Needs Prometheus to be alive.

    2. The Watchdog alert, which fires forever and is never notified about. The
       relay records each arrival; if they stop, the relay says so. Catches a
       dead Prometheus or Alertmanager, which layer 1 cannot by definition.

    3. A systemd timer on the HOST that checks the containers and the relay's
       heartbeat and notifies ntfy directly. Needs no Docker and no Prometheus,
       so it still speaks when the whole stack is down - including when the
       relay itself is the thing that died.
#}
{% set go = '{{' %}
{% set og = '}}' %}
{% set t = monitoring_thresholds %}
groups:

  # ============================================================================
  # THE DEAD MAN'S SWITCH
  # ============================================================================
  - name: frey_watchdog
    rules:

      # Always firing, by design. It is routed to its own receiver and never
      # produces a notification - the relay simply notes that it arrived. The
      # ABSENCE of this is the signal.
      - alert: Watchdog
        expr: vector(1)
        labels:
          severity: none
        annotations:
          summary: "Monitoring pipeline heartbeat"
          description: >-
            This alert always fires and is never notified about. If the relay
            stops receiving it, the relay tells you that monitoring itself is
            broken.

  # ============================================================================
  # THE STACK
  # ============================================================================
  - name: frey_monitoring_stack
    rules:

      - alert: FreyPrometheusTargetDown
        expr: up == 0
        for: {{ t.monitoring.target_down_for }}
        labels:
          severity: warning
        annotations:
          summary: 'Scrape target {{ go }} $labels.job {{ og }} is down'
          description: >-
            Prometheus cannot reach {{ go }} $labels.instance {{ og }}, so
            whatever it measures is now unmonitored and every alert depending
            on it has silently stopped evaluating. That second part is why
            this is not merely cosmetic.

      # A config that fails to load leaves the OLD config running. Everything
      # looks fine and your edit simply had no effect - which is the most
      # annoying possible failure for a change to alert thresholds.
      - alert: FreyPrometheusConfigReloadFailed
        expr: prometheus_config_last_reload_successful == 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Prometheus rejected its configuration"
          description: >-
            The last reload failed, so Prometheus is still running the
            previous config and any change you just deployed is not in effect.
            `docker logs --tail 50 prometheus`.

      - alert: FreyAlertmanagerConfigReloadFailed
        expr: alertmanager_config_last_reload_successful == 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Alertmanager rejected its configuration"
          description: >-
            Running the previous config. Routing and inhibition changes have
            not taken effect.

      # The relay is what actually delivers, so Alertmanager failing to reach
      # it means alerts are being evaluated and going nowhere.
      - alert: FreyAlertDeliveryFailing
        expr: >-
          increase(alertmanager_notifications_failed_total[1h])
          > {{ t.monitoring.notification_failures }}
        for: 10m
        labels:
          severity: critical
        annotations:
          summary: "Alertmanager cannot reach the notification relay"
          description: >-
            Alerts are being evaluated and not delivered. This is the failure
            that makes every other alert in this stack worthless, so it is
            critical even though nothing is "broken" in the van.
            `docker logs --tail 50 alert-relay`.

      - alert: FreyPrometheusTsdbFailures
        expr: increase(prometheus_tsdb_compactions_failed_total[2h]) > 0
        for: 0m
        labels:
          severity: warning
        annotations:
          summary: "Prometheus is failing to compact its database"
          description: >-
            Usually disk or a corrupted block. Left alone the database grows
            and queries get slower until it will not start. Check disk space
            first.

  # ============================================================================
  # DELIVERY AND THE OFFLINE QUEUE
  # ============================================================================
  - name: frey_alert_delivery
    rules:

      # Informational, and arrives after the fact by definition - you cannot
      # be told about a backlog while the backlog exists. It is here so that
      # the reconnect report has a counterpart in the dashboards, and so a
      # queue that never drains is visible.
      - alert: FreyAlertQueueBacklog
        expr: frey_alert_relay_queue_depth > 0
        for: {{ t.monitoring.queue_backlog_for }}
        labels:
          severity: warning
        annotations:
          summary: '{{ go }} $value {{ og }} alert(s) waiting for an uplink'
          description: >-
            Held on disk with the time they really fired, and they will be
            delivered with a summary as soon as there is internet. Nothing is
            lost. If this persists while the uplink IS up, the ntfy topic or
            token is wrong - check `docker logs alert-relay`.

      # ----------------------------------------------------------------------
      # THE RELAY CAN REACH ALERTMANAGER BUT NOT NTFY
      #
      # FreyAlertDeliveryFailing above watches Alertmanager -> relay. This
      # watches relay -> ntfy, which is a different link and the one that
      # actually reaches your phone. It was missing, and the gap was real: a
      # relay with a stale ntfy topic failed every send for hours while
      # looking perfectly healthy from every other angle - running, scraped,
      # answering its health check.
      #
      # Nothing is lost when this fires (the alerts are queued and this one
      # will be delivered with them), but it is the difference between finding
      # out now in Grafana and finding out when you eventually look.
      #
      # Deliberately not keyed on frey_alert_relay_failed_total alone: that is
      # a lifetime counter and will sit at a large number forever after one
      # bad afternoon. `increase` over a window is what distinguishes "is
      # failing" from "has ever failed".
      # ----------------------------------------------------------------------
      - alert: FreyAlertDeliveryToPhoneFailing
        expr: increase(frey_alert_relay_failed_total[30m]) > 10
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: 'The relay cannot reach ntfy ({{ go }} $value {{ og }} failures in 30m)'
          description: >-
            Alerts are being held rather than delivered. Expected while the
            van has no uplink - in which case this clears itself and arrives
            as part of the reconnect report.
            If the uplink IS up, the topic or token is wrong: check
            `docker logs alert-relay`, and confirm the topic in
            {{ monitoring.configure.key_file }} matches the one your phone is
            subscribed to.

      - alert: FreyAlertRelayDown
        expr: frey_alert_relay_up == 0 or absent(frey_alert_relay_up)
        for: 10m
        labels:
          severity: critical
        annotations:
          summary: "The notification relay is not running"
          description: >-
            Nothing can reach your phone while this is true. The host-side
            watchdog timer should also have told you independently; if it did
            not, check `systemctl status {{ monitoring.watchdog.service_name }}.timer`.

  # ============================================================================
  # COLLECTORS
  #
  # The host scripts are where everything van-specific comes from - throttling,
  # power, NVMe health, AP clients, DNS, NAT, and later the cabin temperature.
  # If one stops, those metrics do not go to zero, they simply stop updating,
  # and the dashboards keep showing the last value they saw. That is the most
  # dangerous failure mode in the whole stack: monitoring that looks fine and
  # is lying.
  #
  # node-exporter timestamps each textfile, which is what makes staleness
  # detectable at all.
  # ============================================================================
  - name: frey_collectors
    rules:

      - alert: FreyCollectorFailing
        expr: frey_collector_success == 0
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: 'Host collector {{ go }} $labels.collector {{ og }} is failing'
          description: >-
            It ran and could not gather its metrics. Run it by hand to see
            why: `{{ monitoring.bin_dir }}/frey-metrics {{ go }} $labels.collector {{ og }}`.

      # Two tiers, because the textfile directory has more than one writer and
      # they do not share a cadence. See the long note on
      # `collectors.stale_after_seconds` in defaults/main.yml: judged against
      # the 30s tier, a healthy 15-minute collector reads as frozen. The
      # `file` label is node-exporter's path inside its container, so these
      # match on the basename rather than anchoring the whole string.
      #
      # `\\.` is not a typo and must not be "corrected" to `\.`. The expr is a
      # single-quoted YAML scalar, which passes backslashes through verbatim,
      # and PromQL string literals then use Go escaping - where a lone `\.` is
      # an unknown escape sequence and promtool rejects the whole rule file.
      # Two backslashes here reach the regex engine as one.
      - alert: FreyCollectorStale
        expr: 'time() - node_textfile_mtime_seconds{file!~".*/({{ monitoring.collectors.slow | join("|") }})\\.prom"} > {{ monitoring.collectors.stale_after_seconds }}'
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: 'Metrics file {{ go }} $labels.file {{ og }} has stopped updating'
          description: >-
            Not written for over ten minutes, so every metric in it is now
            frozen at its last value - the dashboards will look healthy and be
            wrong. Check
            `systemctl status {{ monitoring.collectors.service_name }}.timer`.

      # The slow writers have timers of their own, so this one deliberately
      # does NOT name frey-metrics.timer - pointing at the wrong unit is how
      # the previous version of this alert would have sent you looking at a
      # healthy timer. `systemctl list-timers` shows which one owns the file.
      - alert: FreySlowCollectorStale
        expr: 'time() - node_textfile_mtime_seconds{file=~".*/({{ monitoring.collectors.slow | join("|") }})\\.prom"} > {{ monitoring.collectors.slow_stale_after_seconds }}'
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: 'Metrics file {{ go }} $labels.file {{ og }} has stopped updating'
          description: >-
            This file is written minutes apart rather than every 30 seconds,
            and it has now missed several of its own intervals, so its metrics
            are frozen at their last values. Find the timer that owns it with
            `systemctl list-timers --all` and check that unit, not
            {{ monitoring.collectors.service_name }}.timer.

      - alert: FreyTextfileParseErrors
        # A gauge, not a counter - 1 while a file in the directory will not
        # parse, 0 otherwise. `increase()` on it would be meaningless.
        expr: node_textfile_scrape_error > 0
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "node-exporter could not parse a metrics file"
          description: >-
            A .prom file in {{ monitoring.textfile_dir }} is malformed, so its
            metrics are being dropped. If you have just added a van sensor,
            this is almost certainly it - check the file is written
            tmp-then-rename, because a half-written file parses as garbage.

{% if monitoring_enable.logs | bool %}
  # ============================================================================
  # LOGS
  # ============================================================================
  - name: frey_logs
    rules:

      - alert: FreyLogIngestionStopped
        expr: rate(loki_distributor_bytes_received_total[30m]) == 0
        for: {{ t.monitoring.logs_stalled_for }}
        labels:
          severity: warning
        annotations:
          summary: "No logs have arrived in Loki"
          description: >-
            Twenty-one containers and a system journal do not fall silent, so
            this means Alloy has stopped shipping - most likely a bad
            config.alloy, which does not stop Alloy from starting, only from
            working. `docker logs --tail 50 alloy`.

      - alert: FreyLokiRejectingWrites
        # Loki's own rejections only - rate limits, bad labels. The lines
        # deliberately thrown away as noise are dropped by Alloy before they
        # ever reach Loki, so they are counted in Alloy's metrics and never
        # appear here.
        #
        # too_far_behind is excluded and handled by the next rule. Every Alloy
        # restart re-reads each container log from the start and replays
        # entries Loki has already stored or considers too old - 15,230 of them
        # on 2026-10-30, from one restart. With a 1h window that is an hour of
        # firing after any ordinary deploy, which made this alert mean "someone
        # ran Ansible" rather than anything about Loki.
        expr: >-
          increase(loki_discarded_samples_total{reason!="too_far_behind"}[1h]) > 1000
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: 'Loki is discarding log lines ({{ go }} $labels.reason {{ og }})'
          description: >-
            Loki is rejecting writes - usually a rate limit, which means one
            container has started shouting. Find it in the log volume panel
            before it costs NVMe life. `reason=greater_than_max_sample_age`
            instead means the Pi's clock jumped, which happens after a cold
            boot with no uplink and no RTC battery.

      - alert: FreyLokiRejectingOldEntries
        # Separated from the rule above so that the harmless cause and the
        # real one can be told apart by how long they last, which is the only
        # thing that distinguishes them:
        #
        #   an Alloy restart   one burst, over in seconds, then nothing
        #   a clock problem    continuous, because every line is now "old"
        #
        # A 15-minute window that has to stay above the threshold for 45
        # minutes cannot be satisfied by a burst - the increase falls back to
        # zero long before the `for` elapses - but a Pi whose clock jumped
        # backwards keeps it true indefinitely. That is the case worth waking
        # up for, because nothing is being stored while it lasts.
        expr: >-
          increase(loki_discarded_samples_total{reason="too_far_behind"}[15m]) > 1000
        for: 45m
        labels:
          severity: warning
        annotations:
          summary: "Loki has been rejecting log lines as too old for 45 minutes"
          description: >-
            Loki is refusing lines for being older than it will accept, and has
            been for long enough that this is not the usual burst after an
            Alloy restart. The likely cause is the Pi's clock: it has no RTC
            battery, so a cold boot with no uplink starts it in the past and
            every log line looks ancient until NTP catches up. Check `timedatectl`
            first. Nothing is being stored into Loki while this lasts.
{% endif %}
{% if monitoring_enable.log_repair | bool %}

  # ============================================================================
  # DAMAGED CONTAINER LOGS
  #
  # The gap these close: FreyLogIngestionStopped only fires when ingestion
  # stops ENTIRELY. An unclean shutdown stops it for the handful of containers
  # whose json logs were damaged, while the other twenty-odd keep shipping
  # normally - so the ingestion rate stays well above zero and nothing fires.
  #
  # That is not hypothetical. On 2026-10-30 jellyfin, byparr and unpackerr had
  # been shipping nothing for a day; every alert in this file was quiet and
  # Grafana showed three services that merely looked idle.
  # ============================================================================
  - name: frey_log_repair
    rules:

      - alert: FreyContainerLogsDamaged
        # The repair normally clears this within one timer interval, so a
        # value that persists means the repair itself could not fix it -
        # a permissions problem, or a file Docker is holding differently.
        expr: frey_docker_log_corrupt_files > 0
        for: 30m
        labels:
          severity: warning
        annotations:
          summary: "{{ go }} $value {{ og }} container log(s) still damaged after repair"
          description: >-
            An unclean shutdown left NUL bytes in Docker's own json log files,
            and frey-log-repair has not managed to clear them. Until it does,
            those containers ship nothing to Loki while `docker logs` keeps
            working, so they look idle rather than broken.
            `frey-log-repair scan` names them; `journalctl -u frey-log-repair`
            says why the repair failed.

      - alert: FreyContainerLogsRepaired
        # Deliberately an alert and not just a metric. A repair means the Pi
        # lost power uncleanly, which is the live hardware concern on this van
        # - the same event that risks SQLite corruption across the *arrs,
        # Jellyfin and LLDAP. Worth knowing even though the logs themselves
        # are now fixed.
        expr: increase(frey_docker_log_repaired_total[6h]) > 0
        labels:
          severity: warning
        annotations:
          summary: "Container logs were repaired after an unclean shutdown"
          description: >-
            frey-log-repair found and removed NUL-byte damage in at least one
            container's json log. Log shipping is working again. The reason to
            read this is the cause, not the effect: check the unsafe shutdown
            count and the 5V rail before assuming it was a one-off.

      - alert: FreyLogRepairNotRunning
        # The repair is itself a thing that can die quietly, and its whole
        # value is being there after a bad reboot.
        expr: >-
          time() - frey_docker_log_repair_last_run_timestamp_seconds
            > {{ t.monitoring.log_repair_stale_seconds }}
        labels:
          severity: warning
        annotations:
          summary: "frey-log-repair has not run recently"
          description: >-
            The timer that repairs damaged container logs has stopped running,
            so the next unclean shutdown will silently stop some containers
            from shipping logs. `systemctl status frey-log-repair.timer`.
{% endif %}
