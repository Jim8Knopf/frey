{#
  ============================================================================
  DOCKGE - managed by Ansible role: dockge
  Do not edit on the Pi; changes are overwritten on the next deploy.
  ============================================================================

  Yes, the irony is noted: this is the compose file of the tool you would use
  to edit compose files. Change it in roles/dockge/templates/ and deploy.

  Reached only through Traefik, behind forward auth. That is not optional
  politeness - Dockge holds the Docker socket, which is root on the host by
  another name. Anything that can talk to it can start a privileged container
  and own the Pi, so it must never be reachable without logging in.
#}
{% set d = dockge %}
services:
  dockge:
    image: {{ d.image }}
    container_name: {{ d.container_name }}
    hostname: dockge
    restart: unless-stopped
    environment:
      - TZ={{ frey.timezone }}
      # Must match the host-side path of the stacks mount below. Dockge hands
      # these paths to `docker compose`, which runs against the host daemon,
      # so a path that differs inside and outside the container fails in
      # confusing ways.
      - DOCKGE_STACKS_DIR={{ d.stacks_dir }}
    volumes:
      # The Docker socket. This is the whole reason the service is protected.
      - /var/run/docker.sock:/var/run/docker.sock
      - "{{ d.appdata_dir }}:/app/data"
      # The real Frey stacks, so the UI reflects the actual deployment.
      # Read-only unless dockge.stacks_writable is set - the compose files are
      # generated by Ansible and anything saved over them is reverted by the
      # next deploy.
      - "{{ d.stacks_dir }}:{{ d.stacks_dir }}{{ '' if d.stacks_writable | bool else ':ro' }}"
    networks:
      - {{ frey.proxy_network }}
    mem_limit: {{ d.mem_limit }}
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network={{ frey.proxy_network }}"
      - "traefik.http.services.dockge.loadbalancer.server.port={{ d.port }}"
{#
  The same three-router pattern as every other Frey service; see the long
  explanation in roles/media_library/templates/docker-compose.yml.j2.

  Dockge is browser-only, so plain HTTP always redirects to the canonical
  HTTPS name - it has no television problem, and its session must not travel
  unencrypted.
#}
{% set protected = d.host in (identity_protect | default([])) %}
{% set middlewares = ['secure-headers@file'] + (['authelia@file'] if protected else []) %}
      - "traefik.http.routers.dockge.rule=Host(`{{ d.host }}.{{ frey.service_domain }}`)"
      - "traefik.http.routers.dockge.entrypoints=websecure"
      - "traefik.http.routers.dockge.tls=true"
      - "traefik.http.routers.dockge.middlewares={{ middlewares | join(',') }}"
      - "traefik.http.routers.dockge-legacy.rule=Host(`{{ d.host }}.{{ frey.local_domain }}`)"
      - "traefik.http.routers.dockge-legacy.entrypoints=websecure"
      - "traefik.http.routers.dockge-legacy.tls=true"
      - "traefik.http.routers.dockge-legacy.middlewares=to-canonical@file"
      - "traefik.http.routers.dockge-legacy.service=dockge"
      - "traefik.http.routers.dockge-http.rule=Host(`{{ d.host }}.{{ frey.service_domain }}`) || Host(`{{ d.host }}.{{ frey.local_domain }}`)"
      - "traefik.http.routers.dockge-http.entrypoints=web"
      - "traefik.http.routers.dockge-http.service=dockge"
      - "traefik.http.routers.dockge-http.middlewares=to-canonical@file"
      - "frey.module=dockge"

networks:
  {{ frey.proxy_network }}:
    external: true
