# Frey SSH lockout prevention. Managed by Ansible role: security_baseline
#
# This Pi has no Ethernet port and no console. sshd is the only way in, so
# its stock limits are the wrong trade: they are tuned to protect a server
# that someone can walk up to.
#
# The failure these settings prevent was observed on 2026-10-27. sshd kept
# port 22 open and completed the TCP handshake, then closed every
# connection without sending its banner. From outside it is indistinguishable
# from a healthy daemon - nmap calls the port "tcpwrapped" - and because the
# close happens before any username is sent, every account is locked out at
# once. fail2ban cannot help: throttling writes no authentication-failure
# line, so the jail never sees an offender to ban.
#
# The mechanism is MaxStartups saturation, and the stock values invite it:
#   MaxStartups 10:30:100   -> all new connections dropped at 100 in flight
#   LoginGraceTime 120      -> each unauthenticated connection holds a slot
#                              for two minutes
#   PerSourceMaxStartups    -> unset, so ONE host can fill all 100 slots
#
# Anything that opens SSH connections without finishing authentication at
# more than ~50/minute therefore locks the owner out of their own van.

# Recycle abandoned pre-auth slots four times faster. Still ample for a
# human typing a password - the prompt appears immediately.
LoginGraceTime {{ security_baseline.ssh.login_grace_time }}

# More headroom before throttling starts at all.
MaxStartups {{ security_baseline.ssh.max_startups }}

# The actual fix. A scanner on whatever public Wi-Fi the van parked next to
# can now exhaust its own allowance and nobody else's.
PerSourceMaxStartups {{ security_baseline.ssh.per_source_max_startups }}
PerSourceNetBlockSize {{ security_baseline.ssh.per_source_net_block_size }}
