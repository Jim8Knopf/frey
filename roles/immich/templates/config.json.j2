{
  "oauth": {
    "enabled": true,
    "issuerUrl": {{ ('https://' ~ identity_hosts.auth ~ '.' ~ frey.service_domain) | to_json }},
    "clientId": "immich",
    "clientSecret": {{ immich_oidc_secret | to_json }},
    "scope": "openid profile email immich_role",
    "roleClaim": "immich_role",
    "tokenEndpointAuthMethod": "client_secret_post",
    "buttonText": "Sign in with Frey",
    "autoRegister": true,
    "autoLaunch": false
  },
  "server": {"externalDomain": {{ ('https://' ~ immich.host ~ '.' ~ frey.service_domain) | to_json }}},
  "machineLearning": {
    "facialRecognition": {
      "enabled": true,
      "modelName": {{ immich.face.model | to_json }},
      "minScore": {{ immich.face.min_score | float }},
      "maxDistance": {{ immich.face.max_distance | float }},
      "minFaces": {{ immich.face.min_faces | int }}
    }
  },
  "job": {
    "faceDetection": {"concurrency": {{ immich.concurrency.face_detection | int }}},
    "smartSearch": {"concurrency": {{ immich.concurrency.smart_search | int }}},
    "ocr": {"concurrency": {{ immich.concurrency.ocr | int }}}
  }
}
