# Generated by Ansible. Service access is enforced by each service.
pageInfo:
  title: Frey
  description: Your services on FreyHub
appConfig:
  theme: nord
  disableConfiguration: true
  preventWriteToDisk: true
  auth:
    enableOidc: true
    oidc:
      clientId: dashy
      endpoint: "https://{{ identity_hosts.auth }}.{{ frey.service_domain }}"
      adminGroup: frey_admins
      scope: openid profile email groups
sections:
  - name: Device setup
    items:
      - title: Install Frey root certificate
        description: Download the certificate and read setup instructions
        url: {{ ('https://' ~ dashy.host ~ '.' ~ frey.service_domain ~ '/setup') | to_json }}
{% for section in dashy.sections %}
{% set entries = section.services | select('in', identity_services) | list %}
{% set visible = [] %}
{% for name in entries %}
{% set enabled = media_enable[name] if name in media_enable else (monitoring_enable.grafana if name == 'grafana' else (monitoring_enable.metrics if name == 'prometheus' else (monitoring_enable.alerting if name == 'alertmanager' else true))) %}
{% if enabled %}{% set _ = visible.append(name) %}{% endif %}
{% endfor %}
{% if visible | length > 0 %}
  - name: {{ section.name | to_json }}
    items:
{% for name in visible %}
{% set service = identity_services[name] %}
      - title: {{ ('Wi-Fi' if name == 'wifi' else name | title) | to_json }}
        url: {{ ('https://' ~ service.hosts[0] ~ '.' ~ frey.service_domain) | to_json }}
        displayData:
          showForGroups: {{ (service.groups if service.groups | length > 0 else (['frey_admins', 'media'] if name == 'seerr' else ['frey_admins'])) | to_json }}
{% endfor %}
{% endif %}
{% endfor %}
{% set assigned = dashy.sections | map(attribute='services') | flatten %}
{% set other = [] %}
{% for name in identity_services if name not in assigned and name != 'dashy' %}
{% if (media_enable[name] | default(true)) %}{% set _ = other.append(name) %}{% endif %}
{% endfor %}
{% if other | length > 0 %}
  - name: Other services
    items:
{% for name in other %}
{% set service = identity_services[name] %}
      - title: {{ name | title | to_json }}
        url: {{ ('https://' ~ service.hosts[0] ~ '.' ~ frey.service_domain) | to_json }}
        displayData:
          showForGroups: {{ (service.groups if service.groups | length > 0 else ['frey_admins']) | to_json }}
{% endfor %}
{% endif %}
