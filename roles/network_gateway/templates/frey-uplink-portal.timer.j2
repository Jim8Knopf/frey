[Unit]
Description=Frey captive-portal auto-accept - periodic retry
Documentation=file://{{ frey.base_dir | default('/opt/frey') }}/docs/GATEWAY.md

[Timer]
# Run soon after boot: the van is often switched on already parked next to the
# portal it needs to sign in to.
OnBootSec={{ network_gateway.upstream.portal.boot_delay_seconds }}
# Re-checking on an interval rather than only on connect is the point: a
# portal session expires mid-stay, and nothing about the radio changes when
# it does.
OnUnitInactiveSec={{ network_gateway.upstream.portal.interval_seconds }}
AccuracySec=10s
Unit=frey-uplink-portal.service

[Install]
WantedBy=timers.target
