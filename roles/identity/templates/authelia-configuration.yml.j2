{#
  ============================================================================
  AUTHELIA - managed by Ansible role: identity
  Do not edit on the Pi; changes are overwritten on the next deploy.
  ============================================================================

  This file is the entire state of Frey's single sign-on. There is no database
  to reconcile, no API to call and nothing to re-apply: it is rendered,
  validated with `authelia validate-config`, and the container restarts. That
  is the whole reason this stack replaced Authentik.

  IT CONTAINS NO SECRETS. Every secret is pulled at startup from a file in
  /secrets by Authelia's own `secret` template filter, enabled by
  X_AUTHELIA_CONFIG_FILTERS=template in the compose file. That keeps the file
  that actually holds the policy - who may reach what - readable and safe to
  show in `--check --diff`, which was never true of the old stack's blueprints.

  Schema is pinned to Authelia {{ identity_versions.authelia }}. The options
  here move between minor releases, so read roles/identity/README.md before
  bumping the version.
#}
{% set go = '{{' %}
{% set og = '}}' %}
{% set auth_host = identity.hosts.auth ~ '.' ~ frey.service_domain %}
{% set oidc_services = (identity_services | dict2items | selectattr('value.auth', 'equalto', 'oidc') | list) + (identity_services | dict2items | selectattr('value.auth', 'equalto', 'forward_auth') | selectattr('value.oidc_client', 'defined') | selectattr('value.oidc_client', 'equalto', true) | list) %}
{% set fwd_services = identity_services | dict2items | selectattr('value.auth', 'equalto', 'forward_auth') | list %}
---
theme: '{{ identity.authelia.theme }}'

server:
  address: 'tcp://0.0.0.0:{{ identity.authelia.port }}'

  # ----------------------------------------------------------------------------
  # TIMEOUTS - SET TO OUTLIVE TRAEFIK'S IDLE BACKEND CONNECTIONS
  #
  # Authelia's defaults are read 6s, write 6s, idle 30s. Traefik keeps an idle
  # connection in its backend pool for 90s (its own default). So Traefik would
  # dial Authelia, serve the request, keep the connection pooled and unused,
  # and Authelia would hit its 6-second read timeout waiting for a request that
  # was never coming - closing the connection and logging an error:
  #
  #   level=error msg="Request timeout occurred while handling request from
  #   client." error="read tcp ...: i/o timeout" method=GET path=/
  #   status_code=408
  #
  # Nothing is broken when that happens. No user request fails, because the
  # connection carried none. But it is logged at ERROR, about 230 times a day,
  # and it fills {level="error"} in Grafana with a fault that does not exist -
  # which is expensive in the only way that matters: it trains you to ignore
  # the panel that is supposed to tell you something is wrong.
  #
  # The invariant is simply that the side with the pool must give up first.
  # Traefik closes at 90s; these are set above that so Authelia never does.
  # The matching end is pinned in roles/service_proxy/tasks/main.yml - if you
  # raise Traefik's idleConnTimeout, raise idle here to stay above it.
  #
  # HOW WELL THIS IS VERIFIED: the historical rate was about two 408s every ten
  # minutes, steady across a day. With these timeouts live there were none in
  # nine minutes, which is consistent with a fix but is not nine minutes of
  # proof - roughly two were expected in that window. If 408s are still in
  # Authelia's log a day after this lands, the reasoning above is wrong, and
  # the next thing to check is who is opening connections to authelia:9091 and
  # abandoning them: a longer read timeout only delays each log line, it cannot
  # reduce the number of abandoned connections.
  # ----------------------------------------------------------------------------
  timeouts:
    # Generous rather than tight: this listener is only reachable from the
    # proxy on an internal Docker network, never from FreyHub clients, so the
    # slow-request exposure a long read timeout normally buys does not apply.
    read: '120s'
    write: '120s'
    idle: '120s'

log:
  level: '{{ identity.authelia.log_level }}'
  format: 'text'

# ------------------------------------------------------------------------------
# SECOND FACTORS
#
# Enrollable but not required - see identity.authelia.default_policy in
# roles/identity/defaults/main.yml for why one_factor is the default in a van.
# Anyone who wants TOTP can enrol it from the portal at any time.
# ------------------------------------------------------------------------------
totp:
  disable: false
  issuer: '{{ frey.service_domain }}'
  algorithm: 'sha1'
  digits: 6
  period: 30

webauthn:
  disable: false
  display_name: 'Frey'

identity_validation:
  reset_password:
    jwt_secret: '{{ go }} secret "/secrets/authelia_reset_jwt_secret" {{ og }}'

# ------------------------------------------------------------------------------
# WHERE THE PEOPLE ARE
#
# LLDAP, over plain LDAP on a private Docker network. A bind carries the
# password in cleartext, which is exactly why identity_internal exists and why
# this traffic never crosses the shared proxy network.
#
# The bind account is a normal read-only user, NOT the LLDAP admin. The old
# stack's equivalent is the single thing that broke it: an Authentik service
# account cannot do a password bind at all, so Jellyfin's LDAP auth failed with
# "Invalid Credentials" and was never fixed. See
# archive/legacy-stack/LDAP_SSO_ISSUES.md.
# ------------------------------------------------------------------------------
authentication_backend:
  password_reset:
    disable: false
  # How long a user's group membership may be stale. Short, because removing
  # somebody from a group is usually something you want to take effect now.
  refresh_interval: '1m'

  ldap:
    implementation: 'lldap'
    address: 'ldap://lldap:{{ identity.ldap.port }}'
    timeout: '5s'
    start_tls: false
    base_dn: '{{ identity.base_dn }}'
    additional_users_dn: 'ou=people'
    additional_groups_dn: 'ou=groups'
    users_filter: '(&(|({username_attribute}={input})({mail_attribute}={input}))(objectClass=person))'
    groups_filter: '(&(member={dn})(objectClass=groupOfNames))'
    user: 'uid={{ identity.ldap.bind_user }},ou=people,{{ identity.base_dn }}'
    password: '{{ go }} secret "/secrets/authelia_ldap_password" {{ og }}'
    attributes:
      username: 'uid'
      display_name: 'cn'
      mail: 'mail'
      member_of: 'memberOf'
      group_name: 'cn'

# ------------------------------------------------------------------------------
# THE SESSION
#
# The cookie domain is {{ frey.service_domain }} and that is load-bearing.
# Authelia requires a domain with at least one period, and a browser refuses
# Set-Cookie for a bare public suffix - which, under the Public Suffix List's
# default rule for unknown TLDs, `{{ frey.local_domain }}` is. A cookie scoped
# to {{ frey.service_domain }} reaches every service below it, which is what
# makes one login cover all of them.
# ------------------------------------------------------------------------------
session:
  secret: '{{ go }} secret "/secrets/authelia_session_secret" {{ og }}'
  cookies:
    - domain: '{{ frey.service_domain }}'
      authelia_url: 'https://{{ auth_host }}'
      name: 'authelia_session'
      same_site: 'lax'
      expiration: '{{ identity.authelia.session.expiration }}'
      inactivity: '{{ identity.authelia.session.inactivity }}'
      remember_me: '{{ identity.authelia.session.remember_me }}'

# Brute-force protection. Local to Authelia and independent of the fail2ban in
# security_baseline, which only watches sshd.
regulation:
  max_retries: 5
  find_time: '2m'
  ban_time: '10m'

storage:
  encryption_key: '{{ go }} secret "/secrets/authelia_storage_encryption_key" {{ og }}'
  # SQLite, on the NVMe. Authelia stores sessions, TOTP secrets and OIDC
  # consents - small, and not worth a Postgres container. The old stack ran
  # Postgres AND Redis for Authentik; neither is needed here.
  local:
    path: '/config/db.sqlite3'

# Nothing in the van sends mail, and an SMTP notifier that cannot reach a relay
# while parked off-grid is a failure waiting to happen. Password-reset and
# 2FA-enrolment links are written to a file on the Pi instead; read it with
# the command in roles/identity/README.md.
notifier:
  disable_startup_check: false
  filesystem:
    filename: '/config/notification.txt'

# ------------------------------------------------------------------------------
# FORWARD AUTH - WHO MAY REACH WHAT
#
# Generated from identity_services in inventory/group_vars/all/identity.yml.
# default_policy is deny: a host that is not listed here is not reachable
# through forward auth at all, rather than quietly open.
#
# Only forward_auth services appear, including those that also have an OIDC
# client. Services set to `oidc` or `none` do not use this proxy policy.
# ------------------------------------------------------------------------------
access_control:
  default_policy: 'deny'
  rules:
    # The portal must be reachable before anyone can log in. Without this the
    # default deny would lock the login page itself.
    - domain: '{{ auth_host }}'
      policy: 'bypass'
{% for item in fwd_services %}
{% for host in item.value.hosts %}

    # {{ item.key }}
{% if item.value.api_bypass | default(false) %}
    # Machine access first, because the first matching rule wins. An API client
    # cannot answer a 302 to a login page, and these APIs are genuinely driven
    # through the proxy - the media wiring in
    # roles/media_acquisition/tasks/configure/ talks to them over Traefik with
    # a Host header. They carry their own X-Api-Key authentication, which is
    # why media_acquisition.auth.required must stay Enabled.
    - domain: '{{ host }}.{{ frey.service_domain }}'
      policy: 'bypass'
      resources:
        - '^/api([/?].*)?$'
        - '^/feed([/?].*)?$'
        - '^/ping$'

{% endif %}
    - domain: '{{ host }}.{{ frey.service_domain }}'
      policy: '{{ item.value.policy | default(identity.authelia.default_policy) }}'
{% if item.value.groups | length > 0 %}
      subject:
{% for group in item.value.groups %}
        - 'group:{{ group }}'
{% endfor %}
{% endif %}
{% endfor %}
{% endfor %}

# ------------------------------------------------------------------------------
# OIDC - APPS THAT LOG IN AGAINST AUTHELIA THEMSELVES
#
# One client per service with auth: oidc or oidc_client: true. Redirect URIs come from the
# catalog in roles/identity/defaults/main.yml, because they are a property of
# the app rather than a choice.
#
# Note how few there are per app. The old stack listed eight to ten - http and
# https, DNS name, two different LAN addresses, a mobile scheme - because it
# had no single stable base URL to redirect to. There is one now.
#
# A note on editing the client loop below: do NOT put a {# Jinja comment #} on
# its own line inside an indented block. Ansible renders templates with
# trim_blocks on, so the newline after the closing marker is eaten and the
# indentation of the next line is appended to the line before it - which
# produced a 16-space `client_secret` under an 8-space `public`, and a YAML
# parse error 80 lines further down. Keep commentary in this header block.
# ------------------------------------------------------------------------------
{% set abs_maps_groups = ('audiobookshelf' in (oidc_services | map(attribute='key') | list)) and (identity.audiobookshelf.map_groups | default(false) | bool) %}
{% if abs_maps_groups %}
{% set ns = namespace(expr = '["' ~ identity.audiobookshelf.role_fallback ~ '"]') %}
{% for entry in identity.audiobookshelf.role_map | reverse %}
{% set conds = [] %}
{% for g in entry.groups %}
{% set _ = conds.append('"' ~ g ~ '" in groups') %}
{% endfor %}
{% set ns.expr = '(' ~ (conds | join(' || ')) ~ ') ? ["' ~ entry.role ~ '"] : (' ~ ns.expr ~ ')' %}
{% endfor %}
# ------------------------------------------------------------------------------
# DERIVED ATTRIBUTES
#
# Audiobookshelf accepts only the literal roles admin, user and guest, and
# denies any login whose group claim holds none of them. Rather than keep a
# second set of ABS-shaped groups in the directory beside frey_admins and
# media, this turns the groups Frey already has into the word Audiobookshelf
# wants. The claims policy below then serves it to that one client AS its
# `groups` claim, so the app needs no custom scope and the directory needs no
# extra groups.
#
# The trailing fallback is load-bearing: it guarantees the claim is never
# empty, which is the difference between "this person is a guest" and "this
# person cannot sign in".
#
# Edit the mapping at identity.audiobookshelf.role_map in
# roles/identity/defaults/main.yml - this expression is generated from it.
# ------------------------------------------------------------------------------
definitions:
  user_attributes:
    audiobookshelf_roles:
      expression: '{{ ns.expr }}'

{% endif %}
identity_providers:
  oidc:
    hmac_secret: '{{ go }} secret "/secrets/authelia_oidc_hmac_secret" {{ og }}'

    # The token signing key. Generated once on the Pi and never rotated
    # casually: rotating it invalidates every issued token at once.
    jwks:
      - key_id: 'frey'
        algorithm: 'RS256'
        use: 'sig'
        key: {{ go }} secret "/secrets/oidc.jwks.pem" | mindent 10 "|" | msquote {{ og }}

    enforce_pkce: 'public_clients_only'
    enable_client_debug_messages: false

{% if abs_maps_groups %}
    # A scope of its own, because Audiobookshelf appends the name of the claim
    # it wants to the scope it asks for, verbatim. Without this the request
    # names a scope Authelia does not know.
    scopes:
      {{ identity.audiobookshelf.role_claim }}:
        claims:
          - '{{ identity.audiobookshelf.role_claim }}'

{% endif %}

{% if 'dashy' in (oidc_services | map(attribute='key') | list) %}
    cors:
      endpoints: [authorization, token, userinfo, revocation, introspection]
      allowed_origins:
        - 'https://dashy.{{ frey.service_domain }}'
{% endif %}

    lifespans:
      access_token: '1h'
      authorize_code: '1m'
      id_token: '1h'
      refresh_token: '90m'

{% set needs_claims = [] %}
{% for item in oidc_services %}
{% if identity.oidc_catalog[item.key].claims_policy | default('') | length > 0 %}
{% set _ = needs_claims.append(identity.oidc_catalog[item.key].claims_policy) %}
{% endif %}
{% endfor %}
{% if abs_maps_groups %}
{% set _ = needs_claims.append('audiobookshelf_roles') %}
{% endif %}
{% if needs_claims | unique | list | length > 0 %}
    # Some apps read group membership from the ID token rather than fetching it
    # from the userinfo endpoint, which the specification does not require a
    # provider to do. This is Authelia's documented escape hatch for them.
    #
    # audiobookshelf_roles additionally carries abs_role, the translated role
    # from definitions above.
    #
    # It is a claim of its OWN NAME rather than a replacement for `groups`, and
    # that is not a style choice. A custom claim named `groups` validates
    # cleanly and is then silently ignored - `authelia debug oidc claims jason`
    # showed the hydrated claim still holding the raw directory list. Standard
    # claims cannot be overridden this way, and nothing says so at deploy time.
    claims_policies:
{% for policy in needs_claims | unique | sort %}
      {{ policy }}:
{% if abs_maps_groups and policy == 'audiobookshelf_roles' %}
        custom_claims:
          {{ identity.audiobookshelf.role_claim }}:
            attribute: 'audiobookshelf_roles'
{% endif %}
        id_token:
          - 'email'
          - 'email_verified'
          - 'name'
          - 'preferred_username'
          - 'groups'
{% endfor %}

{% endif %}
    # One named policy per OIDC service, so "who may use this app" is answered
    # in exactly the same place and the same way as it is for forward auth.
    authorization_policies:
{% for item in oidc_services %}
      {{ item.key }}:
        default_policy: 'deny'
        rules:
          - policy: '{{ item.value.policy | default(identity.authelia.default_policy) }}'
{% if item.value.groups | length > 0 %}
            subject:
{% for group in item.value.groups %}
              - 'group:{{ group }}'
{% endfor %}
{% endif %}
{% endfor %}

    clients:
{% for item in oidc_services %}
{% set cat = identity.oidc_catalog[item.key] %}
      - client_id: '{{ item.key }}'
        client_name: '{{ cat.client_name }}'
{% if cat.public %}
        # A PUBLIC client: it cannot hold a secret, so it proves itself with
        # PKCE instead. Authelia refuses plain-HTTP redirect URIs for these,
        # which is why frey_pki has to run first.
        public: true
        token_endpoint_auth_method: 'none'
{% else %}
        public: false
        client_secret: '{{ identity_secrets[item.key ~ '_oidc_secret_hash'] | default('$pbkdf2-sha512$CHECK-MODE-ONLY', true) }}'
        token_endpoint_auth_method: '{{ cat.token_endpoint_auth_method }}'
{% endif %}
        authorization_policy: '{{ item.key }}'
        require_pkce: {{ 'true' if cat.require_pkce else 'false' }}
        pkce_challenge_method: '{{ cat.pkce_challenge_method }}'
        consent_mode: 'implicit'
        redirect_uris:
{% for uri in cat.redirect_uris %}
          - '{{ uri }}'
{% endfor %}
        scopes:
{% for scope in cat.scopes %}
          - '{{ scope }}'
{% endfor %}
{% if abs_maps_groups and item.key == 'audiobookshelf' %}
          - '{{ identity.audiobookshelf.role_claim }}'
{% endif %}
        response_types:
          - 'code'
        grant_types:
          - 'authorization_code'
          - 'refresh_token'
{% if abs_maps_groups and item.key == 'audiobookshelf' %}
        claims_policy: 'audiobookshelf_roles'
{% elif cat.claims_policy | default('') | length > 0 %}
        claims_policy: '{{ cat.claims_policy }}'
{% endif %}
{% endfor %}
