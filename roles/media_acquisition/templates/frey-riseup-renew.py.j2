#!/usr/bin/env python3
"""Acquire and renew a Riseup client certificate without exposing its key."""
import concurrent.futures
import datetime
import ipaddress
import json
import os
import re
import socket
import subprocess
import sys
import tempfile
import time
import urllib.request

PROFILE = '{{ media.appdata_dir }}/gluetun/riseup.conf'
API = 'https://api.black.riseup.net/3/'
CA_URL = 'https://black.riseup.net/ca.crt'
PENDING = PROFILE + '.restart-pending'
STACK = '{{ media_acquisition.stack_dir }}/docker-compose.yml'
CLIENTS = [{% for name in ['qbittorrent', 'prowlarr', 'slskd', 'jackett', 'byparr'] %}{% if media_acquisition.services[name].enabled %}'{{ name }}',{% endif %}{% endfor %}]
# Riseup publishes OpenVPN over TCP/80 on every gateway, which is the transport
# that survives a restrictive uplink.
REMOTE_PORT = 80
# How many gateways to write into the profile. OpenVPN walks the list in order,
# so this is the number of independent failures the tunnel rides out with no
# help from this script -- which matters because the script only runs daily and
# a gateway can die at any hour, parked anywhere.
REMOTES_MAX = 8
# Seconds to wait for a gateway's TCP handshake, both when probing here and in
# the profile. OpenVPN's default is 120s per remote; measured 2026-11-17, five
# of Riseup's sixteen gateways were dead, so that default stalled the tunnel
# for minutes at a time and every client sharing its namespace stayed down.
CONNECT_TIMEOUT = 15
# Renew the client certificate once it has less than this long to live.
# Riseup issues them for about 35 days, so this is really the off-grid
# tolerance: it is how much validity the van is guaranteed to be carrying when
# it loses its uplink. An expired certificate cannot be replaced without
# internet, and the tunnel cannot authenticate without one, so downloads stay
# down until an uplink comes back no matter how healthy everything else is.
# 20 days rather than 10 doubles that margin and costs one fetch every ~15 days.
RENEW_WITHIN = 20 * 24 * 3600


def fetch(url):
    # Once running, renew through the VPN: some public networks intercept the
    # provider's website. wget verifies HTTPS using the container CA bundle.
    try:
        state = subprocess.check_output(['docker', 'inspect', '-f', '{{ '{{' }}.State.Health.Status{{ '}}' }}', 'gluetun'], stderr=subprocess.DEVNULL, text=True).strip()
        if state == 'healthy':
            return subprocess.check_output(['docker', 'exec', 'gluetun', 'wget', '-q', '-T', '20', '-O', '-', url], timeout=30)
    except (subprocess.SubprocessError, OSError):
        pass
    with urllib.request.urlopen(url, timeout=20) as response:
        return response.read(1024 * 1024)


def pem(text, kind):
    match = re.search(r'-----BEGIN ' + kind + r'-----.*?-----END ' + kind + r'-----', text, re.S)
    if not match:
        raise ValueError('missing certificate material')
    return match.group(0)


def profile_text():
    with open(PROFILE, encoding='utf-8') as profile:
        return profile.read()


def still_valid():
    try:
        text = profile_text()
        client = re.search(r'<cert>\s*(.*?)\s*</cert>', text, re.S)
        if not client:
            return False
        cert = pem(client.group(1), 'CERTIFICATE')
        return subprocess.run(['openssl', 'x509', '-noout', '-checkend', str(RENEW_WITHIN)], input=cert, text=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
    except (OSError, ValueError):
        return False


def existing_material():
    """The CA, certificate and key already in the profile, or None."""
    try:
        text = profile_text()
        parts = []
        for tag, kind in [('ca', 'CERTIFICATE'), ('cert', 'CERTIFICATE'), ('key', None)]:
            block = re.search(r'<' + tag + r'>\s*(.*?)\s*</' + tag + r'>', text, re.S)
            if not block:
                return None
            body = block.group(1)
            if kind:
                parts.append(pem(body, kind))
            else:
                parts.append(pem(body, 'RSA PRIVATE KEY') if 'RSA PRIVATE KEY' in body else pem(body, 'PRIVATE KEY'))
        return tuple(parts)
    except (OSError, ValueError):
        return None


def current_remotes():
    try:
        return re.findall(r'^remote\s+(\S+)\s', profile_text(), re.M)
    except OSError:
        return []


def latency(address):
    """Seconds to complete a TCP handshake to a gateway, or None if it is dead."""
    start = time.monotonic()
    try:
        with socket.create_connection((address, REMOTE_PORT), CONNECT_TIMEOUT):
            return time.monotonic() - start
    except OSError:
        return None


def reachable(addresses):
    if not addresses:
        return False
    with concurrent.futures.ThreadPoolExecutor(max_workers=len(addresses)) as pool:
        return any(result is not None for result in pool.map(latency, addresses))


def candidates():
    """Every gateway advertising OpenVPN over TCP on REMOTE_PORT."""
    service = json.loads(fetch(API + 'config/eip-service.json'))
    found = []
    for gateway in service['gateways']:
        transports = gateway['capabilities']['transport']
        if any(t.get('type') == 'openvpn' and 'tcp' in t.get('protocols', []) and str(REMOTE_PORT) in t.get('ports', []) for t in transports):
            found.append(str(ipaddress.IPv4Address(gateway['ip_address'])))
    if not found:
        raise ValueError('no gateway advertises OpenVPN over TCP')
    return found


def rank(addresses):
    """Reachable gateways, nearest first.

    Being listed is not being alive -- measured 2026-11-17, the dead gateway
    this script used to hardcode was still advertised by the API -- so each one
    is probed. Latency order matters as much as liveness: it is the largest
    single lever on download throughput, and the gateways are spread across
    three continents.
    """
    with concurrent.futures.ThreadPoolExecutor(max_workers=len(addresses)) as pool:
        measured = zip(addresses, pool.map(latency, addresses))
    alive = sorted(((seconds, address) for address, seconds in measured if seconds is not None))
    # A venue that blocks outbound 80 makes every probe fail. Keep the
    # advertised list rather than writing a profile with no remote at all.
    return [address for _, address in alive] or addresses


def build(remotes, ca, certificate, key):
    lines = ['client', 'dev tun', 'proto tcp-client']
    lines += ['remote ' + address + ' ' + str(REMOTE_PORT) for address in remotes]
    lines += ['connect-timeout ' + str(CONNECT_TIMEOUT), 'nobind', 'persist-key', 'persist-tun',
              'cipher AES-256-GCM', 'data-ciphers AES-256-GCM', 'auth SHA512', 'remote-cert-tls server',
              # Each gateway presents its own CN (vpn23-mia, vpn10-mtl, ...), so
              # pinning one name is exactly what stopped OpenVPN from failing
              # over. The prefix still refuses any certificate that is not a
              # Riseup gateway's, which the embedded CA already constrains.
              'verify-x509-name vpn name-prefix',
              'tls-version-min 1.2', 'pull-filter ignore block-outside-dns', 'verb 1']
    return '\n'.join(lines) + '\n<ca>\n' + ca + '\n</ca>\n<cert>\n' + certificate + '\n</cert>\n<key>\n' + key + '\n</key>\n'


def write(profile):
    os.makedirs(os.path.dirname(PROFILE), exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix='.riseup-', dir=os.path.dirname(PROFILE))
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, 'w', encoding='utf-8') as f:
            f.write(profile)
        os.replace(temporary, PROFILE)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def container_exists(name='gluetun'):
    try:
        subprocess.check_output(['docker', 'inspect', '-f', '{{ '{{' }}.Id{{ '}}' }}', name], stderr=subprocess.DEVNULL)
        return True
    except (subprocess.SubprocessError, OSError):
        return False


def tunnel_is_current():
    """True when Gluetun started after the profile was last written.

    On a first install the profile is written before the Compose stack exists,
    so the container comes up already holding it and the marker left behind is
    stale. Comparing the two timestamps settles that without the deploy having
    to track which case it is in.
    """
    try:
        started = subprocess.check_output(['docker', 'inspect', '-f', '{{ '{{' }}.State.StartedAt{{ '}}' }}', 'gluetun'], stderr=subprocess.DEVNULL, text=True).strip()
        # RFC3339 with nanoseconds, which datetime cannot parse past microseconds.
        started = re.sub(r'(\.\d{6})\d+', r'\1', started).replace('Z', '+00:00')
        return datetime.datetime.fromisoformat(started).timestamp() >= os.path.getmtime(PROFILE)
    except (subprocess.SubprocessError, OSError, ValueError):
        return False


def restart_vpn_and_clients():
    subprocess.run(['docker', 'restart', 'gluetun'], check=True, stdout=subprocess.DEVNULL)
    for _ in range(60):
        state = subprocess.check_output(['docker', 'inspect', '-f', '{{ '{{' }}.State.Health.Status{{ '}}' }}', 'gluetun'], text=True).strip()
        if state == 'healthy':
            break
        time.sleep(3)
    else:
        raise RuntimeError('VPN did not become healthy')
    # Restarting a container creates a new network namespace. Recreate every
    # network_mode:service:gluetun client so none remains in the old one.
    if CLIENTS:
        subprocess.run(['docker', 'compose', '-f', STACK, 'up', '-d', '--no-deps', '--force-recreate'] + CLIENTS, check=True, stdout=subprocess.DEVNULL)
    os.unlink(PENDING)


def obtain():
    material = fetch(API + 'cert').decode()
    certificate = pem(material, 'CERTIFICATE')
    try:
        key = pem(material, 'RSA PRIVATE KEY')
    except ValueError:
        key = pem(material, 'PRIVATE KEY')
    ca = pem(fetch(CA_URL).decode(), 'CERTIFICATE')
    # Riseup uses a separate client CA, so its server CA cannot validate the
    # client certificate. HTTPS authenticates the API response; validate the
    # certificate expiry and key pair before replacing a working file.
    with tempfile.TemporaryDirectory() as d:
        paths = []
        for name, value in [('cert', certificate), ('key', key), ('ca', ca)]:
            path = os.path.join(d, name)
            with open(path, 'w', encoding='utf-8') as f:
                f.write(value + '\n')
            os.chmod(path, 0o600)
            paths.append(path)
        cert_path, key_path, ca_path = paths
        subprocess.run(['openssl', 'x509', '-in', ca_path, '-noout', '-checkend', '864000'], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run(['openssl', 'x509', '-in', cert_path, '-noout', '-checkend', '864000'], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        cert_pub = subprocess.check_output(['openssl', 'x509', '-in', cert_path, '-pubkey', '-noout'])
        key_pub = subprocess.check_output(['openssl', 'pkey', '-in', key_path, '-pubout'], stderr=subprocess.DEVNULL)
        if cert_pub != key_pub:
            raise ValueError('client certificate and key do not match')
    return ca, certificate, key


def main():
    material = existing_material() if still_valid() else None
    # Two independent reasons to rewrite the profile: the certificate is near
    # expiry, or the gateways in it have gone away. Only ever checking the
    # first is what left the tunnel pointed at a dead gateway indefinitely.
    if material and reachable(current_remotes()):
        if '--restart' in sys.argv and os.path.exists(PENDING):
            if not container_exists():
                # A first install, mid-deploy: Compose has not created the
                # tunnel yet and will start it on this very profile.
                print('unchanged')
                return
            if tunnel_is_current():
                os.unlink(PENDING)
                print('unchanged')
                return
            restart_vpn_and_clients()
            print('reconnected')
            return
        print('unchanged')
        return
    try:
        addresses = candidates()
    except (OSError, json.JSONDecodeError):
        # No uplink, or a captive portal answering with its own HTML. Neither
        # is actionable and neither is this script's fault: the dispatcher hook
        # runs again the moment an uplink appears, and the timer keeps trying
        # meanwhile. Exiting non-zero here would leave a failed unit sitting on
        # the monitoring for as long as the van is parked off-grid, which is
        # exactly when a spurious alert is least welcome.
        #
        # A ValueError is deliberately NOT caught: that is candidates() finding
        # no usable gateway in a response it did parse, which means Riseup
        # changed something and somebody does need to know.
        print('offline')
        return
    remotes = rank(addresses)[:REMOTES_MAX]
    if material is None:
        material = obtain()
    profile = build(remotes, *material)
    # Mark before writing, and whether or not --restart was asked for. Gluetun
    # goes on serving the profile it started with, so a rewritten file changes
    # nothing until the tunnel is rebuilt -- and the deploy step that rewrites
    # it runs before the container it would have to restart even exists.
    # The directory is created here rather than only in write(): on a first
    # install nothing has made it yet, and the marker lands first.
    os.makedirs(os.path.dirname(PROFILE), exist_ok=True)
    fd = os.open(PENDING, os.O_WRONLY | os.O_CREAT, 0o600)
    os.close(fd)
    write(profile)
    print('updated')
    if '--restart' in sys.argv and container_exists():
        restart_vpn_and_clients()


if __name__ == '__main__':
    try:
        main()
    except Exception as exc:
        print('Riseup renewal failed: ' + type(exc).__name__, file=sys.stderr)
        sys.exit(1)
