# qBittorrent WebUI credentials for frey-media-gate.
# Managed by Ansible role: media_acquisition. Root-only (0600).
#
# Kept out of the script itself so the script can stay world-readable and be
# inspected without exposing the password.
QBT_USERNAME={{ media_acquisition.services.qbittorrent.web_username }}
QBT_PASSWORD={{ media_secrets.qbittorrent_password }}
