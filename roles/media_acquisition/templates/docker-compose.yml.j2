{#
  ============================================================================
  MEDIA ACQUISITION STACK - managed by Ansible role: media_acquisition
  Do not edit on the Pi; changes are overwritten on the next deploy.
  ============================================================================

  DESIGN RULES, and why the archived role broke them:

  1. NO PUBLISHED PORTS. Every web UI is reached through Traefik on
     frey_proxy. The firewall only opens 80/443 downstream, so the old
     stack's dozen host port mappings were unreachable from FreyHub clients
     anyway - while still being exposed on the uplink side.

  2. ONE /data MOUNT. Identical path in every container, so an import is a
     hardlink. The old split of /downloads + /tv + /movies forced a full copy
     per import.

  3. frey_media NEVER OVERLAPS 10.20.0.0/24. The archived role put this
     network on the access point's own subnet, which would have taken
     FreyHub down - the one service that must always survive.

  4. EVERY IMAGE PINNED. No `latest`: an unattended pull on a campground
     Wi-Fi must not be able to break the stack.

  5. EVERY CONTAINER CAPPED. FreyHub is the only way in - no Ethernet, no
     console - so nothing here may OOM the Pi or starve the gateway.
#}
{% set m = media_acquisition %}
{% set svc = m.services %}
{% set tz = frey.timezone %}
{% set appdata = media.appdata_dir %}
{% set auth_method = m.auth.method | default('External') %}
{% set auth_required = m.auth.required | default('DisabledForLocalAddresses') %}

{% macro logging() %}
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
{%- endmacro %}

{#
  Point a container at the stack's own resolver.

  Setting `dns:` does NOT replace Docker's embedded resolver - resolv.conf
  keeps 127.0.0.11 - it replaces what that resolver forwards to. So
  container-name lookups (prowlarr -> sonarr, prowlarr -> byparr) keep
  working exactly as before; only external names change path. Verified on the
  Pi before this was written, because getting it wrong would have broken
  every service-to-service call in the stack.

  `depends_on` only orders startup here; it is not a health gate. dnsmasq is
  up in well under a second, and anything that does race it retries.
#}
{% macro stack_dns() %}
{% if svc.resolver.enabled | bool %}
    dns:
      - {{ m.dns.address }}
    depends_on:
      - resolver
{% endif %}
{%- endmacro %}

{#
  Two routers per service: the canonical one on {{ frey.service_domain }}, and
  a legacy one on {{ frey.local_domain }} that redirects to it. See the note on
  frey.service_domain in inventory/group_vars/all/main.yml for why the domain
  gained a label - single sign-on needs a cookie domain with a period in it.

  `authelia@file` is added for any service listed as forward_auth in
  inventory/group_vars/all/identity.yml, which is every service in this stack.
  These UIs already run with AUTH__METHOD=External - "something in front of me
  is doing the authenticating" - and this is that something finally arriving.
  Nothing inside the containers changes.
#}
{% macro proxy_labels(name, port) %}
{% set protected = name in (identity_protect | default([])) %}
{% set middlewares = ['secure-headers@file'] + (['authelia@file'] if protected else []) %}
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network={{ frey.proxy_network }}"
      - "traefik.http.services.{{ name }}.loadbalancer.server.port={{ port }}"
      - "traefik.http.routers.{{ name }}.rule=Host(`{{ name }}.{{ frey.service_domain }}`)"
      - "traefik.http.routers.{{ name }}.entrypoints=websecure"
      - "traefik.http.routers.{{ name }}.tls=true"
      - "traefik.http.routers.{{ name }}.middlewares={{ middlewares | join(',') }}"
      - "traefik.http.routers.{{ name }}-legacy.rule=Host(`{{ name }}.{{ frey.local_domain }}`)"
      - "traefik.http.routers.{{ name }}-legacy.entrypoints=websecure"
      - "traefik.http.routers.{{ name }}-legacy.tls=true"
      - "traefik.http.routers.{{ name }}-legacy.middlewares=to-canonical@file"
      - "traefik.http.routers.{{ name }}-legacy.service={{ name }}"
      - "traefik.http.routers.{{ name }}-http.rule=Host(`{{ name }}.{{ frey.service_domain }}`) || Host(`{{ name }}.{{ frey.local_domain }}`)"
      - "traefik.http.routers.{{ name }}-http.entrypoints=web"
      - "traefik.http.routers.{{ name }}-http.service={{ name }}"
{% if protected %}
      # Protected, so plain HTTP cannot be served: Authelia's session cookie is
      # Secure and would never come back over HTTP, leaving a redirect loop
      # instead of a login. Upgrade to the canonical HTTPS URL instead.
      - "traefik.http.routers.{{ name }}-http.middlewares=to-canonical@file"
      # ----------------------------------------------------------------------
      # MACHINE ACCESS - the REST API, which must NOT get a login page
      #
      # An API client cannot answer a forward-auth 302 or follow a redirect to
      # a name it may not resolve. And these APIs really are driven through
      # Traefik: tasks/configure/ wires the whole stack together over
      # http://10.20.0.1 with a Host header, because the Pi does not
      # necessarily resolve its own *.frey names and nothing here publishes a
      # port. RSS readers and any other key-holding client are in the same
      # position.
      #
      # So API paths skip the session check and are authenticated by
      # X-Api-Key instead. That is only safe because
      # media_acquisition.auth.required is Enabled - left at Servarr's default
      # of DisabledForLocalAddresses the key is waived for private source
      # addresses, which every request arriving through Traefik has, and this
      # router would then be an unauthenticated door into the API.
      #
      # Higher priority than -http so these paths are matched before the
      # blanket redirect.
      # ----------------------------------------------------------------------
      - "traefik.http.routers.{{ name }}-api.rule=(Host(`{{ name }}.{{ frey.service_domain }}`) || Host(`{{ name }}.{{ frey.local_domain }}`)) && (PathPrefix(`/api`) || PathPrefix(`/feed`) || PathPrefix(`/ping`))"
      - "traefik.http.routers.{{ name }}-api.entrypoints=web"
      - "traefik.http.routers.{{ name }}-api.service={{ name }}"
      - "traefik.http.routers.{{ name }}-api.middlewares=secure-headers@file"
      - "traefik.http.routers.{{ name }}-api.priority=100"
{% else %}
      - "traefik.http.routers.{{ name }}-http.middlewares=secure-headers@file"
{% endif %}
      - "frey.module=media_acquisition"
{%- endmacro %}

{#
  Shared shape for the Servarr-family apps. They really are identical apart
  from image, port and which media directory they own, so one macro is
  safer here than six hand-maintained copies.

  The API key is injected as an environment variable so Ansible knows it
  before the app ever starts. Auth method defaults to External: there is no
  way to seed a Servarr local user without writing its database, and these
  UIs sit on a private LAN behind the FreyHub passphrase. When the auth
  module lands, Traefik forward-auth goes in front and `External` is already
  the correct setting.
#}
{% macro arr_service(name, cfg, extra_volumes=[]) %}
  {{ name }}:
    image: {{ cfg.image }}
    container_name: {{ cfg.container_name }}
    hostname: {{ cfg.hostname }}
    restart: unless-stopped
    environment:
      - PUID={{ media.user.uid }}
      - PGID={{ media.user.gid }}
      - TZ={{ tz }}
      - UMASK={{ media.umask }}
      - {{ cfg.env_prefix }}__AUTH__APIKEY={{ media_secrets[name] }}
      - {{ cfg.env_prefix }}__AUTH__METHOD={{ auth_method }}
      - {{ cfg.env_prefix }}__AUTH__REQUIRED={{ auth_required }}
      - {{ cfg.env_prefix }}__SERVER__PORT={{ cfg.port }}
      - {{ cfg.env_prefix }}__LOG__LEVEL=info
    volumes:
      - "{{ appdata }}/{{ name }}:/config"
      - "{{ media.data_dir }}:/data"
{% for volume in extra_volumes %}
      - "{{ volume }}"
{% endfor %}
    networks:
      - {{ frey.proxy_network }}
      - {{ media.network.name }}
{{ stack_dns() }}
{{ proxy_labels(name, cfg.port) }}
    mem_limit: {{ cfg.mem_limit }}
{% if cfg.cpus is defined %}
    cpus: "{{ cfg.cpus }}"
{% endif %}
    pids_limit: 512
    security_opt:
      - no-new-privileges:true
{{ logging() }}
{#
  A healthcheck is only safe where the image actually has curl.

  This is not a cosmetic concern: Traefik's Docker provider EXCLUDES a
  container whose healthcheck is failing, so a healthcheck that cannot
  possibly pass silently removes the service from the proxy and every
  request to it returns 404 - with nothing in Traefik's log to say why.

  That is exactly what happened to Chaptarr on first deploy: its image ships
  no curl, the check failed forever, and chaptarr.frey 404'd while the app
  itself was perfectly healthy and answering on its own port.
#}
{% if cfg.healthcheck_enabled | default(true) %}
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://localhost:{{ cfg.port }}/ping || exit 1"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 120s
{% endif %}
{%- endmacro %}

networks:
  # Created by service_proxy. Traefik lives here; this is the only path from
  # a FreyHub client to any of these UIs.
  {{ frey.proxy_network }}:
    external: true
  # Created by this role with an explicitly pinned subnet. App-to-app traffic
  # only - Prowlarr talking to Sonarr, Bazarr talking to Radarr.
  {{ media.network.name }}:
    external: true

services:
{% if svc.resolver.enabled | bool %}
{#
  The stack's own resolver, and the first service here on purpose: everything
  below names it in `dns:`, and an indexer search is the first thing the
  *arrs do on start.

  It exists to strip AAAA records. The van's uplink has no usable IPv6 route,
  campground DNS serves AAAA for Cloudflare-fronted trackers anyway, and
  .NET's HttpClient - unlike curl - does not fall back to IPv4, so every
  search dies with "Resource temporarily unavailable" and Prowlarr disables
  the indexer for hours. See the `dns:` note in defaults/main.yml.

  It gets a FIXED address because Docker's `dns:` takes addresses, not names.
#}
  resolver:
    image: {{ svc.resolver.image }}
    container_name: {{ svc.resolver.container_name }}
    hostname: {{ svc.resolver.hostname }}
    restart: unless-stopped
    environment:
      - TZ={{ tz }}
    volumes:
      - "{{ appdata }}/resolver/dnsmasq.conf:/etc/dnsmasq.conf:ro"
    networks:
      {{ media.network.name }}:
        ipv4_address: {{ m.dns.address }}
    labels:
      - "traefik.enable=false"
      - "frey.module=media_acquisition"
    mem_limit: {{ svc.resolver.mem_limit }}
    pids_limit: 64
    # dnsmasq binds port 53 inside its own namespace, which is unprivileged
    # here, but it still wants CAP_NET_BIND_SERVICE on some kernels.
    cap_add:
      - NET_BIND_SERVICE
    security_opt:
      - no-new-privileges:true
{{ logging() }}
{#
  Probe what actually matters: that a real name still resolves through this
  container. A dnsmasq that is up but forwarding to a dead upstream is not
  healthy for our purposes, and Docker marking it unhealthy is the signal.

  busybox nslookup, which is what this Alpine image ships - no -type flag,
  because older busybox builds do not take one.
#}
    healthcheck:
      test: ["CMD-SHELL", "nslookup cloudflare.com 127.0.0.1 >/dev/null 2>&1 || exit 1"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 20s

{% endif %}
{% if svc.prowlarr.enabled | bool %}
{{ arr_service('prowlarr', svc.prowlarr) }}

{% endif %}
{% if svc.sonarr.enabled | bool %}
{{ arr_service('sonarr', svc.sonarr) }}

{% endif %}
{% if svc.radarr.enabled | bool %}
{{ arr_service('radarr', svc.radarr) }}

{% endif %}
{% if svc.lidarr.enabled | bool %}
{{ arr_service('lidarr', svc.lidarr) }}

{% endif %}
{% if svc.chaptarr.enabled | bool %}
{#
  Chaptarr: the maintained successor to Readarr, which was retired in June
  2025 when its metadata sources became unusable. Handles audiobooks and
  ebooks in one instance. Not a linuxserver image, but it honours PUID/PGID
  and is Servarr-based, so the same shape applies.
#}
{{ arr_service('chaptarr', svc.chaptarr) }}

{% endif %}
{% if svc.bazarr.enabled | bool %}
  bazarr:
    image: {{ svc.bazarr.image }}
    container_name: {{ svc.bazarr.container_name }}
    hostname: {{ svc.bazarr.hostname }}
    restart: unless-stopped
    environment:
      - PUID={{ media.user.uid }}
      - PGID={{ media.user.gid }}
      - TZ={{ tz }}
      - UMASK={{ media.umask }}
    volumes:
      # Bazarr is configured by a plain YAML file, which Ansible templates
      # directly - no API dance needed.
      - "{{ appdata }}/bazarr:/config"
      - "{{ media.data_dir }}:/data"
    networks:
      - {{ frey.proxy_network }}
      - {{ media.network.name }}
{{ proxy_labels('bazarr', svc.bazarr.port) }}
    mem_limit: {{ svc.bazarr.mem_limit }}
    pids_limit: 512
    security_opt:
      - no-new-privileges:true
{{ logging() }}

{% endif %}
{% if m.vpn.enabled | bool %}
{#
  ============================================================================
  GLUETUN - the VPN tunnel, present only when media_vpn.enabled is true
  ============================================================================

  qBittorrent below joins this container's network namespace, so ALL of its
  traffic - trackers, peers, DHT - leaves through the tunnel and nothing else.
  If the tunnel drops, Gluetun's firewall blocks the lot rather than falling
  back to the campground's network: downloads stop instead of leaking. That
  killswitch is the reason for doing it this way instead of pointing
  qBittorrent at a SOCKS proxy, which fails open.

  Consequences, handled automatically elsewhere in this role:
    - qBittorrent has no hostname of its own, so Traefik routes its web UI to
      THIS container, and the *arrs address it as `gluetun`
      (media_acquisition.vpn.qbittorrent_host).
    - FIREWALL_OUTBOUND_SUBNETS must list the Docker networks, or Gluetun
      blocks Traefik and the *arrs along with everything else and the web UI
      becomes unreachable.
#}
  gluetun:
    image: {{ m.vpn.image }}
    container_name: {{ m.vpn.container_name }}
    hostname: {{ m.vpn.hostname }}
    restart: unless-stopped
    cap_add:
      - NET_ADMIN
    devices:
      - /dev/net/tun:/dev/net/tun
    environment:
      - TZ={{ tz }}
      - VPN_SERVICE_PROVIDER={{ media_vpn.provider }}
      - VPN_TYPE={{ media_vpn.type }}
{% if media_vpn.type == 'wireguard' %}
      - WIREGUARD_PRIVATE_KEY={{ media_vpn.credentials.wireguard_private_key }}
      - WIREGUARD_ADDRESSES={{ media_vpn.credentials.wireguard_addresses }}
{% if media_vpn.credentials.wireguard_preshared_key | length > 0 %}
      - WIREGUARD_PRESHARED_KEY={{ media_vpn.credentials.wireguard_preshared_key }}
{% endif %}
{% else %}
      - OPENVPN_USER={{ media_vpn.credentials.openvpn_user }}
      - OPENVPN_PASSWORD={{ media_vpn.credentials.openvpn_password }}
{% endif %}
{% if media_vpn.server_countries | length > 0 %}
      - SERVER_COUNTRIES={{ media_vpn.server_countries | join(',') }}
{% endif %}
      # Without these, the killswitch blocks Traefik and the *arrs too.
      - FIREWALL_OUTBOUND_SUBNETS={{ media_vpn.allowed_subnets | join(',') }}
      # Gluetun's own DNS-over-TLS, so lookups do not leak to the venue's
      # resolver. It does not affect FreyHub clients - only this namespace.
      - DOT=on
      - HEALTH_VPN_DURATION_INITIAL=30s
    volumes:
      - "{{ appdata }}/gluetun:/gluetun"
    networks:
      - {{ frey.proxy_network }}
      - {{ media.network.name }}
{#
  The qBittorrent web UI is routed to Gluetun, because that is where the
  listening socket actually lives once qBittorrent shares this namespace.
#}
{% if svc.qbittorrent.enabled | bool %}
{{ proxy_labels('qbittorrent', svc.qbittorrent.port) }}
{% else %}
    labels:
      - "traefik.enable=false"
      - "frey.module=media_acquisition"
{% endif %}
    mem_limit: {{ m.vpn.mem_limit }}
    pids_limit: 512
{{ logging() }}
    healthcheck:
      test: ["CMD-SHELL", "/gluetun-entrypoint healthcheck"]
      interval: 60s
      timeout: 20s
      retries: 3
      start_period: 60s

{% endif %}
{% if svc.qbittorrent.enabled | bool %}
  qbittorrent:
    image: {{ svc.qbittorrent.image }}
    container_name: {{ svc.qbittorrent.container_name }}
{% if m.vpn.enabled | bool %}
    # Inside the tunnel's network namespace: no interface, no hostname and no
    # networks of its own, and therefore no way to reach the internet except
    # through the VPN. Its web UI is published by Gluetun's Traefik labels.
    network_mode: "service:gluetun"
    depends_on:
      gluetun:
        condition: service_healthy
{% else %}
    hostname: {{ svc.qbittorrent.hostname }}
{% endif %}
    restart: unless-stopped
    environment:
      - PUID={{ media.user.uid }}
      - PGID={{ media.user.gid }}
      - TZ={{ tz }}
      - UMASK={{ media.umask }}
      - WEBUI_PORT={{ svc.qbittorrent.port }}
      - TORRENTING_PORT={{ svc.qbittorrent.listen_port }}
    volumes:
      - "{{ appdata }}/qbittorrent:/config"
      - "{{ media.data_dir }}:/data"
{% if not (m.vpn.enabled | bool) %}
    networks:
      - {{ frey.proxy_network }}
      - {{ media.network.name }}
{#
  Tracker announces are name lookups too, so qBittorrent gets the same
  AAAA-free resolver as the *arrs. With the VPN on it cannot: it has no
  network namespace of its own and takes Gluetun's DNS, which already
  resolves inside the tunnel.
#}
{{ stack_dns() }}
{#
  The torrent listen port is deliberately NOT published. Parked behind a
  venue's NAT there is no inbound path to forward anyway, so publishing it
  would open the uplink side for nothing. Outbound peer connections work
  regardless.
#}
{{ proxy_labels('qbittorrent', svc.qbittorrent.port) }}
{% else %}
    labels:
      # Routing is Gluetun's job while the tunnel owns the network namespace.
      - "traefik.enable=false"
      - "frey.module=media_acquisition"
{% endif %}
    mem_limit: {{ svc.qbittorrent.mem_limit }}
    cpus: "{{ svc.qbittorrent.cpus }}"
    pids_limit: 1024
    security_opt:
      - no-new-privileges:true
{{ logging() }}
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://localhost:{{ svc.qbittorrent.port }} || exit 1"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 60s

{% endif %}
{% if svc.byparr.enabled | bool %}
{#
  Byparr replaces FlareSolverr, which was archived upstream and no longer
  clears the Cloudflare challenges trackers use. It speaks the same API on
  the same port, so Prowlarr registers it as a FlareSolverr proxy.

  It drives a real browser engine, so it gets the tightest cap in the stack
  and is reachable only on the internal network.
#}
  byparr:
    image: {{ svc.byparr.image }}
    container_name: {{ svc.byparr.container_name }}
    hostname: {{ svc.byparr.hostname }}
    restart: unless-stopped
    environment:
      - TZ={{ tz }}
      - LOG_LEVEL=info
    networks:
      - {{ media.network.name }}
{{ stack_dns() }}
    labels:
      - "traefik.enable=false"
      - "frey.module=media_acquisition"
    mem_limit: {{ svc.byparr.mem_limit }}
    cpus: "{{ svc.byparr.cpus }}"
    pids_limit: 512
    # A browser engine needs more than the default 64MB of shared memory or
    # it crashes on heavier pages.
    shm_size: 256m
    security_opt:
      - no-new-privileges:true
{{ logging() }}
{#
  NOT /health. In Byparr 3.x that endpoint performs a real browser solve and
  takes longer than any sane probe timeout, so the container sat permanently
  "unhealthy" while working perfectly. /docs answers instantly and still
  proves the HTTP server is alive.
#}
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS -o /dev/null http://localhost:{{ svc.byparr.port }}{{ svc.byparr.health_path }} || exit 1"]
      interval: 60s
      timeout: 15s
      retries: 3
      start_period: 120s

{% endif %}
{% if svc.recyclarr.enabled | bool %}
{#
  Recyclarr pulls TRaSH-guide quality profiles and custom formats into Sonarr
  and Radarr on a schedule. Config-as-code beats hand-maintaining scoring
  tables in two separate web UIs.
#}
  recyclarr:
    image: {{ svc.recyclarr.image }}
    container_name: {{ svc.recyclarr.container_name }}
    restart: unless-stopped
    user: "{{ media.user.uid }}:{{ media.user.gid }}"
    environment:
      - TZ={{ tz }}
      - CRON_SCHEDULE={{ svc.recyclarr.cron }}
      - RECYCLARR_CREATE_CONFIG=false
    volumes:
      - "{{ appdata }}/recyclarr:/config"
    networks:
      - {{ media.network.name }}
    labels:
      - "traefik.enable=false"
      - "frey.module=media_acquisition"
    mem_limit: {{ svc.recyclarr.mem_limit }}
    pids_limit: 256
    security_opt:
      - no-new-privileges:true
{{ logging() }}

{% endif %}
{% if svc.cleanuparr.enabled | bool %}
{#
  Cleanuparr strikes downloads that stall, crawl or refuse to import, removes
  them, blocks the release and tells the *arr to search again. On a van's
  intermittent uplink this does more real work than on a home server.
#}
  cleanuparr:
    image: {{ svc.cleanuparr.image }}
    container_name: {{ svc.cleanuparr.container_name }}
    hostname: {{ svc.cleanuparr.hostname }}
    restart: unless-stopped
    environment:
      - TZ={{ tz }}
      - PORT={{ svc.cleanuparr.port }}
    volumes:
      - "{{ appdata }}/cleanuparr:/config"
    networks:
      - {{ frey.proxy_network }}
      - {{ media.network.name }}
{{ proxy_labels('cleanuparr', svc.cleanuparr.port) }}
    mem_limit: {{ svc.cleanuparr.mem_limit }}
    pids_limit: 256
    security_opt:
      - no-new-privileges:true
{{ logging() }}

{% endif %}
{% if svc.unpackerr.enabled | bool %}
{#
  Unpackerr extracts archived releases so imports do not silently stall
  waiting on a .rar nobody unpacked.
#}
  unpackerr:
    image: {{ svc.unpackerr.image }}
    container_name: {{ svc.unpackerr.container_name }}
    restart: unless-stopped
    user: "{{ media.user.uid }}:{{ media.user.gid }}"
    environment:
      - TZ={{ tz }}
{% if svc.sonarr.enabled | bool %}
      - UN_SONARR_0_URL=http://{{ svc.sonarr.hostname }}:{{ svc.sonarr.port }}
      - UN_SONARR_0_API_KEY={{ media_secrets.sonarr }}
      - UN_SONARR_0_PATHS_0=/data/torrents/tv
{% endif %}
{% if svc.radarr.enabled | bool %}
      - UN_RADARR_0_URL=http://{{ svc.radarr.hostname }}:{{ svc.radarr.port }}
      - UN_RADARR_0_API_KEY={{ media_secrets.radarr }}
      - UN_RADARR_0_PATHS_0=/data/torrents/movies
{% endif %}
{% if svc.lidarr.enabled | bool %}
      - UN_LIDARR_0_URL=http://{{ svc.lidarr.hostname }}:{{ svc.lidarr.port }}
      - UN_LIDARR_0_API_KEY={{ media_secrets.lidarr }}
      - UN_LIDARR_0_PATHS_0=/data/torrents/music
{% endif %}
    volumes:
      - "{{ media.data_dir }}:/data"
    networks:
      - {{ media.network.name }}
    labels:
      - "traefik.enable=false"
      - "frey.module=media_acquisition"
    mem_limit: {{ svc.unpackerr.mem_limit }}
    pids_limit: 256
    security_opt:
      - no-new-privileges:true
{{ logging() }}

{% endif %}
