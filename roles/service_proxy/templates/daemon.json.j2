{
  "data-root": "{{ service_proxy.docker.data_root }}",
  "default-address-pools": [
    {"base": "{{ service_proxy.docker.default_address_pool }}", "size": {{ service_proxy.docker.default_address_pool_size }}}
  ],
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "{{ service_proxy.docker.log_max_size }}",
    "max-file": "{{ service_proxy.docker.log_max_file }}"
  },
  "storage-driver": "overlay2",
  "live-restore": true,
  "iptables": true,
  "userland-proxy": false
}
