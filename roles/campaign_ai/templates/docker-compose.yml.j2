# Managed by Ansible. Do not edit on the Pi.
services:
  gateway:
    image: {{ campaign_ai.gateway_image }}
    container_name: frey-campaign-ai-gateway
    restart: unless-stopped
    user: "65534:65534"
    command:
      - --entrypoints.web.address=:8080
      - --providers.file.filename=/etc/traefik/route.yml
      - --accesslog=false
    volumes:
      - "{{ campaign_ai.stack_dir }}/route.yml:/etc/traefik/route.yml:ro"
    networks:
      - {{ frey.proxy_network }}
      - ai_private
    mem_limit: 128m
    security_opt: [no-new-privileges:true]
    cap_drop: [ALL]
    read_only: true
    tmpfs: [/tmp]
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network={{ frey.proxy_network }}"
      - "traefik.http.services.campaign-ai.loadbalancer.server.port=8080"
      - "traefik.http.routers.campaign-ai.rule=Host(`{{ campaign_ai.host }}.{{ frey.service_domain }}`)"
      - "traefik.http.routers.campaign-ai.entrypoints=websecure"
      - "traefik.http.routers.campaign-ai.tls=true"
      - "traefik.http.routers.campaign-ai.middlewares=secure-headers@file,authelia@file"
      - "traefik.http.routers.campaign-ai-legacy.rule=Host(`{{ campaign_ai.host }}.{{ frey.local_domain }}`)"
      - "traefik.http.routers.campaign-ai-legacy.entrypoints=websecure"
      - "traefik.http.routers.campaign-ai-legacy.tls=true"
      - "traefik.http.routers.campaign-ai-legacy.middlewares=to-canonical@file"
      - "traefik.http.routers.campaign-ai-legacy.service=campaign-ai"
      - "traefik.http.routers.campaign-ai-http.rule=Host(`{{ campaign_ai.host }}.{{ frey.service_domain }}`) || Host(`{{ campaign_ai.host }}.{{ frey.local_domain }}`)"
      - "traefik.http.routers.campaign-ai-http.entrypoints=web"
      - "traefik.http.routers.campaign-ai-http.middlewares=to-canonical@file"
      - "traefik.http.routers.campaign-ai-http.service=campaign-ai"
  model:
    profiles: [model]
    image: {{ campaign_ai.image }}
    container_name: frey-campaign-ai-model
    restart: unless-stopped
    user: "65534:65534"
    command: ["-m", "/models/{{ campaign_ai.model_file }}", "--host", "0.0.0.0", "--port", "8080", "--threads", "2", "--ctx-size", "8192", "--jinja", "--chat-template-kwargs", '{"enable_thinking":false}']
    volumes:
      - "{{ campaign_ai.model_dir }}:/models:ro"
    networks:
      - ai_private
    cpus: 2.0
    mem_limit: 3g
    security_opt: [no-new-privileges:true]
    cap_drop: [ALL]
    read_only: true
    tmpfs: [/tmp]
networks:
  {{ frey.proxy_network }}:
    external: true
  ai_private:
    internal: true
