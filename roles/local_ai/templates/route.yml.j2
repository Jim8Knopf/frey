# Managed by Ansible. Do not edit on the Pi.
#
# One gateway, two hostnames, dispatched on Host.
#
#   ai.hub.frey        the model: its own chat UI and the /v1 API
#   campaign.hub.frey  the assistant that can read and write the notes
#
# They are separate ORIGINS deliberately. llama.cpp's web UI registers a
# service worker, which intercepts every request to its origin and kept
# serving the cached model-only chat even after a hard reload - so putting the
# assistant on the same hostname made it unreachable in a browser no matter
# what the routing said. A separate origin has no service worker to shadow it.
#
# NOTE: Traefik's file provider does not reliably pick up edits to this file
# through the bind mount, so the role restarts the gateway whenever it
# changes. Without that, fixes here sit unused and Traefik answers with its
# own 404 - recognisable because the response carries no Server header.
http:
  routers:
{% if local_ai.campaign.enabled | bool %}
    # Host first, so the assistant's origin never falls through to the model.
    campaign:
      rule: Host(`{{ local_ai.campaign_host }}.{{ frey.service_domain }}`) || Host(`{{ local_ai.campaign_host }}.{{ frey.local_domain }}`)
      service: campaign
{% endif %}
    model:
      rule: PathPrefix(`/`)
      service: model
  services:
    model:
      loadBalancer:
        servers:
          - url: http://model:8080
{% if local_ai.campaign.enabled | bool %}
    campaign:
      loadBalancer:
        servers:
          - url: http://campaign:{{ local_ai.campaign.port }}
{% endif %}
