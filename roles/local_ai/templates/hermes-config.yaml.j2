# Managed by Ansible. Do not edit on the Pi - it will be reverted.
#
# Hermes Agent reads this from HERMES_HOME. It replaces the ~1,800-line sample
# the image ships: everything omitted here keeps the image's own default, and
# only the settings Frey actually depends on are stated.
#
# WHY THIS FILE EXISTS AT ALL, rather than environment variables: the provider
# is NOT settable by env. HERMES_PROVIDER is not read; `model.provider` below
# is the only thing that selects a transport. Getting this wrong does not
# produce a clear error - see the block above `provider` for what it produces
# instead.
{# Same derivation as docker-compose.yml.j2: the registry entry that
   default_model names. Defined here too because a Jinja `set` is local to
   its own template. #}
{% set m = local_ai.models[local_ai.default_model] %}
# Hermes migrates its config by version and warns when it cannot: "This config
# predates version 12 (~2 years old) and can no longer be auto-migrated ... or
# manually set _config_version: 12". This file is generated against the
# current release, so it is current by construction - stating the version
# stops Hermes trying to migrate a file that was never old.
_config_version: 12

model:
  # The served model's id exactly as llama-server reports it in /v1/models.
  # Hermes sends this string through verbatim; llama.cpp ignores the value and
  # serves whatever it loaded, but Hermes puts it in its own logs and uses it
  # to look up a context length, so a placeholder here is actively harmful.
  default: "/models/{{ m.file }}"

  # `custom`, and not the two values that look more correct:
  #
  #   `auto`      resolves to provider `openai-api` as soon as an OPENAI_*
  #               variable is present, and openai-api's transport is the Codex
  #               RESPONSES API - POSTs to /v1/responses, which llama.cpp does
  #               not implement. It does not 404 in any way Hermes reports:
  #               the call simply produces no events and dies as
  #               "Non-streaming API call timed out after 240s with no
  #               response", three times, then trips a stale-attempt breaker.
  #               Every early failure here was this, and nothing named it.
  #
  #   `llamacpp`  is reserved for a llama-server that HERMES supervises and
  #               resolves through its own state file. Pointed at an external
  #               one it raises LocalRuntimeUnavailableError, "The local model
  #               server is turned off", while the server is plainly running.
  #
  # `custom` selects chat_completion_stream_request, which is the streaming
  # chat-completions path llama.cpp actually speaks.
  provider: "custom"
  base_url: "http://model:8080/v1"

  # MUST match the -c the model is served with, and it is NOT detected
  # correctly. llama-server's /v1/models does report n_ctx, but Hermes's probe
  # did not read it ("Could not detect context length ... defaulting to
  # 256,000 tokens (probe-down)") and then fell back to a catalogue guess from
  # the word "qwen" in the filename: "Using hardcoded context length
  # 131,072".
  #
  # That guess is exactly twice what is served. Left alone, Hermes budgets a
  # 131k window against a 65,536-token server, and the overflow is not
  # refused: llama-server truncates the prompt, so the OLDEST part of a long
  # conversation disappears with nothing reported at either end. Stating the
  # real number is what keeps Hermes's own trimming honest.
  context_length: {{ m.ctx }}

dashboard:
  # The scheme and host Hermes must believe it is reached on. WITHOUT THIS the
  # login bounce asks Authelia for
  # redirect_uri=http://hermes.{{ frey.service_domain }}/auth/callback - plain HTTP, because
  # Traefik's hop to the container is plain HTTP and uvicorn only trusts
  # X-Forwarded-Proto from a proxy listed in dashboard.trusted_proxies
  # (loopback by default, and Traefik is not loopback).
  #
  # Authelia then rejects the request as a redirect_uri mismatch against the
  # https URI registered in identity.oidc_catalog.hermes, and reports it in
  # ITS OWN log rather than Hermes's. Setting the public URL fixes the cause
  # rather than registering an http callback, which would put the
  # authorization code on the wire unencrypted.
  #
  # Stated explicitly rather than trusting a forwarded header, because the
  # alternative needs Traefik's container IP or its Docker subnet, and both
  # change when Traefik is recreated.
  public_url: "https://{{ local_ai.hermes_host }}.{{ frey.service_domain }}"

  oauth:
    self_hosted:
      # Authelia. Hermes discovers everything else from
      # {issuer}/.well-known/openid-configuration, so the issuer must be the
      # HTTPS name on the Frey certificate rather than a container address -
      # the issuer is pinned into the ID token's `iss` claim and compared, so
      # http://authelia:9091 would verify against the wrong value even though
      # it is reachable.
      issuer: "https://{{ identity_hosts.auth }}.{{ frey.service_domain }}"
      client_id: hermes
      scopes: "{{ local_ai.hermes.oidc_scopes }}"
      client_secret: "{{ local_ai_hermes_oidc_secret }}"

# THE SETTING THAT DECIDES WHETHER THIS IS USABLE, and the reason this file is
# templated rather than left to the image's defaults.
#
# `-t/--toolsets` is a per-invocation CLI flag, so it does nothing for a
# long-running `hermes dashboard`. The persistent equivalent is this key, and
# `hermes tools --summary` reports exactly one platform on this deployment -
# CLI - which is also the platform the dashboard's own turns run as
# (`turn_context: ... platform=cli`).
#
# A saved list is authoritative even when empty; an ABSENT key means "no
# restriction" and gives all 21 tools, i.e. a ~12,800-token prompt and about
# an hour to first token. The loader wants a YAML list of toolset keys and
# warns loudly if given anything else, so a typo here is visible in the log
# rather than silent.
platform_toolsets:
  cli:
{% for ts in local_ai.hermes.toolsets %}
    - {{ ts }}
{% endfor %}

# THE SECOND MOST IMPORTANT SETTING HERE, after platform_toolsets.
#
# Hermes's default is max_bytes: 50000 - roughly 11,000 tokens, which at the
# 6.9 tok/s measured on this Pi is about 27 MINUTES of prefill for a single
# file read, and it is paid again on the next turn because the tool result
# lands in the conversation. The defaults are written for a provider that
# prefills in seconds.
tool_output:
  max_bytes: {{ local_ai.hermes.tool_output_max_bytes }}
  max_lines: {{ local_ai.hermes.tool_output_max_lines }}
  max_line_length: {{ local_ai.hermes.tool_output_max_line_length }}

agent:
  # THE ONLY THING THAT TELLS HERMES THE CAMPAIGN WIKI EXISTS.
  #
  # Mounting the notes is not enough: nothing in the prompt mentioned them, so
  # the model had to guess a path it had never been told. Two routes that look
  # right and are not:
  #
  #   AGENTS.md  - agent.coding_context is "auto", which injects AGENTS.md
  #                and CLAUDE.md only when the cwd is a CODE workspace. A
  #                SilverBullet space is not one, so the file is read by
  #                nothing and warns about nothing.
  #   a skill    - the whole skill mechanism rides on the `skills` TOOLSET,
  #                which platform_toolsets deliberately excludes. With it off,
  #                `hermes prompt-size` reports "skills index: 0 B" and
  #                skills.auto_load silently loads nothing. Turning it on
  #                costs 4,738 B of tool schemas, about 2.5 minutes of extra
  #                prefill on every cold turn, to carry one paragraph.
  #
  # environment_hint is the mechanism meant for this - its own documentation
  # describes it as stating the layout "without editing SOUL.md". Additive
  # (SOUL.md REPLACES the identity block; this does not), lands in the stable
  # tier so it caches, and costs only its own bytes.
  environment_hint: |
    The SilverBullet campaign wiki is mounted READ-ONLY at
    {{ local_ai.hermes.notes_mount }} - Markdown files, one page each. The
    campaign is under {{ local_ai.hermes.notes_mount }}/{{ local_ai.campaign.root }}/.

    It is a TREE, not one flat folder. Pages are nested in subdirectories -
    NPCs/, Rules/, Templates/ and others - and new subdirectories appear
    whenever a new kind of page is added, so the layout is not fixed and must
    not be assumed.

    To find a page, use search_files across
    {{ local_ai.hermes.notes_mount }}/{{ local_ai.campaign.root }} and match on the
    title or on words you expect in the body. One search beats walking the
    tree: a directory listing only shows one level, and every extra tool call
    costs minutes on this machine.

    NEVER conclude a page does not exist because it was not in the one
    directory you listed. A character, ship or faction is almost certainly in
    a subdirectory named after its kind. Search before saying something is not
    written down.

    Never invent canon. If a name, faction, ship or event is not in a file,
    say it is not written down yet - do not fill the gap with something
    plausible. This wiki is the only record, and a confident invention is
    indistinguishable from a fact once it is repeated back. Say which page a
    fact came from.

    You CAN write, but only inside
    {{ local_ai.hermes.notes_mount }}/{{ local_ai.hermes.notes_write_root }}. Everything
    else is mounted read-only and an attempted write there simply fails -
    including the space root and, inside the campaign itself,
{% for sub in local_ai.hermes.notes_readonly_subdirs %}
    {{ local_ai.hermes.notes_write_root }}/{{ sub }},
{% endfor %}
    which you may read and copy the shape of but never modify.

    When extending a page, read it first and keep what is already there.
    Prefer a patch over rewriting a whole page: re-emitting a long page costs
    minutes on this machine, and a patch is a few lines. Match the structure
    of the matching file in Templates/ when you create a new page.

    Every change is committed to git on a timer, so an edit is recoverable -
    but say plainly what you changed and where, because a silent edit to the
    only record of the campaign is worse than a slow one.

  # A wall-clock ceiling on one question. Hermes gives the model a wrap-up
  # notice at 80% of it, so a long answer ends deliberately instead of being
  # cut off. Without this a tool loop can hold the single model slot for
  # hours, and every other interface waits behind it.
  run_budget_seconds: {{ local_ai.hermes.run_budget_seconds }}

auxiliary:
  title_generation:
    # Hermes names each conversation by ASKING A MODEL. That is one extra call
    # per conversation, against a model that needs minutes per call, for a
    # label - and it was the one thing observed failing and retrying here,
    # because the auxiliary lane has a 30 s no-progress cutoff this hardware
    # cannot meet. false keeps Hermes's instant derived title instead.
    model_upgrade_enabled: false

compression:
  # Hermes compacts the conversation by SUMMARISING IT WITH THE MODEL. On a
  # 65,536-token window the threshold floors at 0.75, so it fires around 49k
  # tokens - and when it does, it costs a full model call: minutes of silence
  # with nothing on screen.
  #
  # Default is to filter those statuses as noise, which on fast hardware is
  # right and here would turn a ten-minute compaction into an apparent hang.
  # Showing them is the difference between "it is working" and "it is broken".
  progress_notices: true

terminal:
  # Start where the content is, so a relative path in a question means the
  # notes rather than Hermes's own home.
  cwd: "{{ local_ai.hermes.notes_mount }}"

skills:
  # The notes are mounted, and a mounted directory is a place Hermes would
  # otherwise scan for PROJECT skills - producing untrusted-skill notices and
  # prompt bytes for a space that contains none.
  project_discovery: false

