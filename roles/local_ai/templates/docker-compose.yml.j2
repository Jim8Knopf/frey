# Managed by Ansible. Do not edit on the Pi.
#
# Two containers on purpose. The gateway speaks to Frey's authenticated proxy;
# the model sits on an internal-only network with no egress, no Docker socket,
# no credentials and nothing mounted but its own weights, read-only. Widening
# what the assistant can answer must never widen what it can reach.
{% set m = local_ai.models[local_ai.default_model] %}
services:
  gateway:
    image: {{ local_ai.gateway_image }}
    container_name: frey-local-ai-gateway
    restart: unless-stopped
    user: "65534:65534"
    command:
      - --entrypoints.web.address=:8080
      - --providers.file.filename=/etc/traefik/route.yml
      - --accesslog=false
    volumes:
      - "{{ local_ai.stack_dir }}/route.yml:/etc/traefik/route.yml:ro"
    networks:
      - {{ frey.proxy_network }}
      - ai_private
    mem_limit: 128m
    security_opt: [no-new-privileges:true]
    cap_drop: [ALL]
    read_only: true
    tmpfs: [/tmp]
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network={{ frey.proxy_network }}"
      - "traefik.http.services.local-ai.loadbalancer.server.port=8080"
      - "traefik.http.routers.local-ai.rule=Host(`{{ local_ai.host }}.{{ frey.service_domain }}`)"
      - "traefik.http.routers.local-ai.entrypoints=websecure"
      - "traefik.http.routers.local-ai.tls=true"
      - "traefik.http.routers.local-ai.middlewares=secure-headers@file,authelia@file"
      - "traefik.http.routers.local-ai-legacy.rule=Host(`{{ local_ai.host }}.{{ frey.local_domain }}`)"
      - "traefik.http.routers.local-ai-legacy.entrypoints=websecure"
      - "traefik.http.routers.local-ai-legacy.tls=true"
      - "traefik.http.routers.local-ai-legacy.middlewares=to-canonical@file"
      - "traefik.http.routers.local-ai-legacy.service=local-ai"
      - "traefik.http.routers.local-ai-http.rule=Host(`{{ local_ai.host }}.{{ frey.service_domain }}`) || Host(`{{ local_ai.host }}.{{ frey.local_domain }}`)"
      - "traefik.http.routers.local-ai-http.entrypoints=web"
      - "traefik.http.routers.local-ai-http.middlewares=to-canonical@file"
      - "traefik.http.routers.local-ai-http.service=local-ai"
{% if local_ai.campaign.enabled | bool %}
      # The assistant's own hostname, same gateway, same auth. route.yml
      # dispatches on Host so this reaches the assistant rather than the model.
      - "traefik.http.routers.assistant.rule=Host(`{{ local_ai.assistant_host }}.{{ frey.service_domain }}`)"
      - "traefik.http.routers.assistant.entrypoints=websecure"
      - "traefik.http.routers.assistant.tls=true"
      - "traefik.http.routers.assistant.middlewares=secure-headers@file,authelia@file"
      - "traefik.http.routers.assistant.service=local-ai"
      - "traefik.http.routers.assistant-legacy.rule=Host(`{{ local_ai.assistant_host }}.{{ frey.local_domain }}`)"
      - "traefik.http.routers.assistant-legacy.entrypoints=websecure"
      - "traefik.http.routers.assistant-legacy.tls=true"
      - "traefik.http.routers.assistant-legacy.middlewares=to-canonical@file"
      - "traefik.http.routers.assistant-legacy.service=local-ai"
      - "traefik.http.routers.assistant-http.rule=Host(`{{ local_ai.assistant_host }}.{{ frey.service_domain }}`) || Host(`{{ local_ai.assistant_host }}.{{ frey.local_domain }}`)"
      - "traefik.http.routers.assistant-http.entrypoints=web"
      - "traefik.http.routers.assistant-http.middlewares=to-canonical@file"
      - "traefik.http.routers.assistant-http.service=local-ai"
{% endif %}
{% if local_ai.hermes.enabled | bool %}
      # Hermes's hostname, same gateway, and DELIBERATELY WITHOUT
      # authelia@file. Hermes is an OIDC relying party that runs its own login
      # against Authelia, so forward auth here would mean authenticating twice
      # for one service. Access is still restricted to
      # identity_services.hermes.groups, which Authelia applies before it
      # issues a token - taking the middleware off does not widen who gets in.
      #
      # secure-headers stays: that is transport hardening, not authentication.
      - "traefik.http.routers.hermes.rule=Host(`{{ local_ai.hermes_host }}.{{ frey.service_domain }}`)"
      - "traefik.http.routers.hermes.entrypoints=websecure"
      - "traefik.http.routers.hermes.tls=true"
      - "traefik.http.routers.hermes.middlewares=secure-headers@file"
      - "traefik.http.routers.hermes.service=local-ai"
      - "traefik.http.routers.hermes-legacy.rule=Host(`{{ local_ai.hermes_host }}.{{ frey.local_domain }}`)"
      - "traefik.http.routers.hermes-legacy.entrypoints=websecure"
      - "traefik.http.routers.hermes-legacy.tls=true"
      - "traefik.http.routers.hermes-legacy.middlewares=to-canonical@file"
      - "traefik.http.routers.hermes-legacy.service=local-ai"
      - "traefik.http.routers.hermes-http.rule=Host(`{{ local_ai.hermes_host }}.{{ frey.service_domain }}`) || Host(`{{ local_ai.hermes_host }}.{{ frey.local_domain }}`)"
      - "traefik.http.routers.hermes-http.entrypoints=web"
      - "traefik.http.routers.hermes-http.middlewares=to-canonical@file"
      - "traefik.http.routers.hermes-http.service=local-ai"
{% endif %}
  model:
    profiles: [model]
    image: {{ local_ai.image }}
    container_name: frey-local-ai-model
    restart: unless-stopped
    user: "65534:65534"
    command:
      - "-m"
      - "/models/{{ m.file }}"
{% if local_ai.webui.enabled | bool and local_ai_webui_present | default(false) | bool %}
      # llama.cpp's own UI. Passed ONLY when the assets are actually on disk:
      # --path at an empty directory makes llama-server serve 404s for its own
      # UI, which looks exactly like the 415 this was added to fix. A deploy
      # with no uplink leaves this off rather than half-on.
      - "--path"
      - "/ui"
{% endif %}
{% if m.mmproj_file is defined and m.enable_vision | default(false) | bool %}
      # Only when vision is explicitly wanted: the projector disables
      # cache_reuse server-wide, which costs minutes of re-prefill on every
      # turn. See enable_vision in defaults/main.yml.
      - "--mmproj"
      - "/models/{{ m.mmproj_file }}"
{% endif %}
      - "--host"
      - "0.0.0.0"
      - "--port"
      - "8080"
      - "--threads"
      - "{{ m.threads }}"
{% if m.threads_batch is defined %}
      # Prompt processing gets more threads than generation: compute-bound
      # versus memory-bandwidth-bound. See threads_batch in defaults/main.yml.
      - "--threads-batch"
      - "{{ m.threads_batch }}"
{% endif %}
      - "--ctx-size"
      - "{{ m.ctx }}"
{% if m.parallel_slots is defined %}
      - "--parallel"
      - "{{ m.parallel_slots }}"
{% endif %}
{% if m.cache_ram is defined %}
      # Caps the idle-slot prompt cache. llama.cpp defaults this to 8192 MiB,
      # which is bigger than this container's whole budget and OOM-killed the
      # server on 2026-11-11. See cache_ram in defaults/main.yml.
      - "--cache-ram"
      - "{{ m.cache_ram }}"
{% endif %}
      - "--cache-reuse"
      - "{{ m.cache_reuse }}"
{% if m.spec_type | default('') | length > 0 %}
      # Speculative decoding from n-grams already in the context: no draft
      # model and no extra memory. See spec_type in defaults/main.yml.
      - "--spec-type"
      - "{{ m.spec_type }}"
{% endif %}
{% if m.cache_reuse | int > 0 %}
      # cache_reuse works "via KV shifting" and llama-server refuses it with
      # "cache_reuse is not supported by this context" unless context shift is
      # on - and --context-shift defaults to DISABLED in b12019. Without this
      # pair, only an exact common prefix is reusable, and Hermes's changing
      # timestamp sits early enough in its prompt to invalidate nearly all of
      # it: measured f_keep 0.17-0.34, ~1,900 tokens re-prefilled per turn,
      # about four minutes before the first generated word.
      - "--context-shift"
{% endif %}
{% if m.cache_type_k is defined %}
      - "--cache-type-k"
      - "{{ m.cache_type_k }}"
{% endif %}
{% if m.cache_type_v is defined %}
      - "--cache-type-v"
      - "{{ m.cache_type_v }}"
{% endif %}
      - "-fa"
      - "{{ m.flash_attn }}"
      - "--temp"
      - "{{ m.temperature }}"
      - "--top-p"
      - "{{ m.top_p }}"
      - "--top-k"
      - "{{ m.top_k }}"
      - "--min-p"
      - "{{ m.min_p }}"
      - "--presence-penalty"
      - "{{ m.presence_penalty }}"
{% if m.repeat_penalty is defined %}
      # Only for models whose publisher recommends one. LFM2.5 asks for 1.05;
      # the Qwen entry omits the key and keeps llama.cpp's default.
      - "--repeat-penalty"
      - "{{ m.repeat_penalty }}"
{% endif %}
      - "--jinja"
      # --reasoning, not --chat-template-kwargs: b12019 warns at startup that
      # setting enable_thinking through chat-template-kwargs is deprecated.
      # This flag sets the same template variable internally.
      - "--reasoning"
      - "{{ 'on' if m.enable_thinking | bool else 'off' }}"
    volumes:
      - "{{ local_ai.model_dir }}:/models:ro"
{% if local_ai.webui.enabled | bool and local_ai_webui_present | default(false) | bool %}
      - "{{ local_ai.webui.dist_dir }}:/ui:ro"
{% endif %}
    networks:
      - ai_private
    cpus: {{ m.cpus }}
    mem_limit: {{ m.mem_limit }}
    security_opt: [no-new-privileges:true]
    cap_drop: [ALL]
    read_only: true
    tmpfs: [/tmp]
{% if local_ai.observer.enabled | bool %}
{% set o = local_ai.observer %}
  observer:
    profiles: [observer]
    image: {{ o.image }}
    container_name: {{ o.container_name }}
    restart: unless-stopped
    user: "{{ o.uid }}:{{ o.gid }}"
    command: ["python3", "-u", "{{ o.script_path }}"]
    environment:
      - TZ={{ frey.timezone }}
      - PYTHONDONTWRITEBYTECODE=1
      - FREY_NODE={{ frey.node_name }}
      - OBSERVER_LOG_LEVEL={{ o.log_level }}
      - PROM_URL=http://prometheus:9090
      - LOKI_URL=http://loki:3100
      - ALERTMANAGER_URL=http://alertmanager:9093
      - RELAY_URL=http://alert-relay:8080
      - MODEL_URL=http://model:8080
      - DRAFTS_DIR=/drafts
      - TEXTFILE_DIR=/textfile
      - NOTES_DIR=/notes
      - POLL_SECONDS={{ o.poll_seconds }}
      - DAILY_HOUR={{ o.daily_hour }}
      - MAX_TOKENS={{ o.max_tokens }}
      - MODEL_TIMEOUT={{ o.model_timeout }}
      - NOTIFY_SEVERITY={{ o.notify_severity }}
      - RUNBOOK_PAGE={{ o.runbook_page }}
    volumes:
      # Read broadly, write to an explicit allowlist. Only two paths are
      # read-write: the drafts directory and the broker's request queue.
      # Everything else is :ro, and credential material is not mounted at all
      # - so the denial is ENOENT rather than EACCES, and no code of ours has
      # to be correct for that to hold.
      - "{{ o.drafts_dir }}:/drafts"
{% if local_ai.broker.enabled | bool %}
      # The only channel to anything privileged. Write a request here; read
      # the answer from a directory that is read-only to this container, so
      # the agent cannot forge its own response.
      - "{{ local_ai.broker.req_dir }}:/broker/req"
      - "{{ local_ai.broker.res_dir }}:/broker/res:ro"
{% endif %}
      - "{{ local_ai.stack_dir }}/observer.py:{{ o.script_path }}:ro"
{% for path in local_ai_observer_read_paths | default([]) %}
      - "{{ path.src }}:{{ path.dest }}:ro"
{% endfor %}
    networks:
      # Both internal. The observer therefore has no route to the internet,
      # which is what makes its broad read access safe: there is nowhere to
      # send anything, and its only output is a file you read.
      - ai_private
      - {{ frey.ai_observe_network }}
    cpus: {{ o.cpus }}
    mem_limit: {{ o.mem_limit }}
    security_opt: [no-new-privileges:true]
    cap_drop: [ALL]
    read_only: true
    tmpfs: [/tmp]
{% endif %}
{% if local_ai.campaign.enabled | bool %}
{% set c = local_ai.campaign %}
  campaign:
    profiles: [campaign]
    image: {{ c.image }}
    container_name: {{ c.container_name }}
    restart: unless-stopped
    user: "{{ c.uid }}:{{ c.gid }}"
{% if local_ai.broker.enabled | bool %}
    # Runs as SilverBullet's uid so it can write notes, plus the broker's
    # queue group so it can write into the request queue, which is
    # group-owned by that gid at 0770.
    group_add: ["{{ local_ai.broker.queue_gid }}"]
{% endif %}
    command: ["python3", "-u", "{{ c.script_path }}"]
    environment:
      - TZ={{ frey.timezone }}
      - PYTHONDONTWRITEBYTECODE=1
      - CAMPAIGN_LOG_LEVEL={{ c.log_level }}
      - MODEL_URL=http://model:8080
      - MODEL_NAME=/models/{{ m.file }}
      - CAMPAIGN_SPACE=/notes
      - CAMPAIGN_ROOT={{ c.root }}
      - CAMPAIGN_TRANSCRIPT=/state/{{ c.transcript_file }}
      - CAMPAIGN_READONLY={{ c.readonly_subdirs | join(',') }}
      - CAMPAIGN_POLL_SECONDS={{ c.poll_seconds }}
      - CAMPAIGN_MODEL_TIMEOUT={{ c.model_timeout }}
      - CAMPAIGN_MAX_TOKENS={{ c.max_tokens }}
      - CAMPAIGN_MAX_STEPS={{ c.max_steps }}
      - CAMPAIGN_TOOL_RESULT_BUDGET={{ c.tool_result_budget }}
      - CAMPAIGN_PORT={{ c.port }}
{% if local_ai.broker.enabled | bool %}
      - BROKER_REQ_DIR=/broker/req
      - BROKER_RES_DIR=/broker/res
{% endif %}
    volumes:
      # The WHOLE space, read-write, since 2026-11-20. It used to be nested -
      # space read-only with only the campaign subtree writable - so the
      # kernel enforced the write scope. Generalising this from a campaign
      # assistant to a notes assistant gave that up deliberately.
      #
      # What that means for anyone reading this later: the write boundary is
      # now `root` and `readonly_subdirs` INSIDE the agent process, not the
      # mount table, and git (frey-notes-commit.timer) is the primary backstop
      # rather than a secondary one. roles/local_ai/tests/
      # test_assistant_write_scope.py exists because of this move.
      #
      # Setting `root` back to a subtree re-narrows the agent but NOT the
      # mount; restoring the kernel-enforced version means restoring the
      # nested mounts here too.
      - "{{ frey.notes_data_dir }}/spaces/notes:/notes"
      # Its own state, holding the chat transcript. Outside the notes space on
      # purpose: a conversation log is not a note anyone asked for.
      - "{{ c.state_dir }}:/state"
      - "{{ local_ai.stack_dir }}/campaign.py:{{ c.script_path }}:ro"
{% if local_ai.broker.enabled | bool %}
      # The only channel to anything privileged, and read verbs only. Requests
      # go in; answers come from a directory that is read-only here, so the
      # assistant cannot forge a reply to itself.
      - "{{ local_ai.broker.req_dir }}:/broker/req"
      - "{{ local_ai.broker.res_dir }}:/broker/res:ro"
{% endif %}
    networks:
      # ai_private only: it needs the model and nothing else. internal, so it
      # has no egress and cannot reach the host on any port.
      #
      # It DOES have broker access - the two queue mounts above - which is
      # deliberate and is the only privileged channel it has. The comment here
      # used to claim the opposite ("no broker access and no system verbs at
      # all"), four lines below the mounts that grant it, which is the worst
      # kind of wrong comment: it would have made a reader mis-assess this
      # container's blast radius. The queues are the boundary, not the
      # network: requests go in, and /broker/res is read-only here so the
      # assistant cannot forge a reply to itself.
      - ai_private
    cpus: {{ c.cpus }}
    mem_limit: {{ c.mem_limit }}
    security_opt: [no-new-privileges:true]
    cap_drop: [ALL]
    read_only: true
    tmpfs: [/tmp]
{% endif %}
{% if local_ai.hermes.enabled | bool %}
{% set h = local_ai.hermes %}
  hermes:
    profiles: [hermes]
    image: {{ h.image }}
    container_name: {{ h.container_name }}
    restart: unless-stopped
    # NO `user:` here, and no `init: true` either - both were tried and both
    # are wrong, in ways the image tells you about only after it fails:
    #
    #   `user:` makes s6-overlay's preinit die in a restart loop, because it
    #   refuses to continue unless /run belongs to the container uid and it
    #   has no privileges left to fix it ("/run belongs to uid 0 instead of
    #   10003 ... and we're lacking the privileges to fix it", exit 100). The
    #   image's own message is explicit: "DON'T use --user", pass HERMES_UID
    #   and HERMES_GID instead and it remaps its user at boot.
    #
    #   `init: true` hides that crash rather than fixing it: with an init
    #   process as PID 1, s6 notices it is not PID 1 and skips itself - so
    #   nothing drops privileges and the agent runs as ROOT. That is how the
    #   one-shot measurements were taken, which is fine for a measurement and
    #   not fine for a service.
    #
    # So: start as root, let s6 fix /run and drop to the uid below.
    # `sleep infinity`, and this is NOT laziness - it is the image's own
    # architecture, and getting it wrong silently breaks conversation storage.
    #
    # The container's CMD runs as s6's "main program", not as a supervised
    # service, and container_boot.py calls _is_dashboard_container(argv):
    # when argv[0] == "dashboard" it declares the container dashboard-only and
    # SKIPS gateway reconciliation entirely ("reconcile: skipping (dashboard
    # container - does not need per-profile gateways)"). The gateway is what
    # owns the session store, so with `dashboard` as the CMD the web UI works,
    # the model answers, and every message is thrown away: `sessions/` stays
    # empty and state.db's `messages` table holds 0 rows, with only a startup
    # warning naming it ("Session store is not initialized. Start this
    # profile's gateway to initialize it.").
    #
    # The supported shape is to let s6 run both: main-hermes is deliberately a
    # no-op (`exec sleep infinity` in the image), the dashboard is a real
    # supervised service gated by HERMES_DASHBOARD, and profile-gateways
    # registers the root gateway. So the CMD only has to keep the container
    # alive, and the wrapper explicitly supports `sleep` ("first arg is an
    # executable -> exec it directly").
    command: ["sleep", "infinity"]
    environment:
      - TZ={{ frey.timezone }}
      # The supported way to own the data volume as a non-root uid: the image
      # remaps its `hermes` user to these at boot and chowns /opt/data to
      # match. PUID/PGID are accepted aliases.
      - HERMES_UID={{ h.uid }}
      - HERMES_GID={{ h.gid }}
      # Runs the dashboard as a supervised s6 service instead of as the CMD,
      # which is what leaves gateway reconciliation switched on.
      - HERMES_DASHBOARD=1
      - HERMES_DASHBOARD_HOST=0.0.0.0
      - HERMES_DASHBOARD_PORT={{ h.port }}
      # Stands in for the --skip-build flag, which the image's dashboard
      # service does not pass. Without either, main_dashboard.py runs the web
      # UI build - npm, on a Pi, possibly with no uplink. Pointing at the
      # bundle the image already ships skips it.
      - HERMES_WEB_DIST=/opt/hermes/hermes_cli/web_dist
      # httpx 0.28.1 builds its SSL context with ssl.create_default_context(),
      # which reads this - verified in the image against
      # https://{{ identity_hosts.auth }}.{{ frey.service_domain }}, where OIDC discovery
      # returned 200 and the expected issuer. Without it the back channel
      # fails inside the OIDC library, which an app-level "trust everything"
      # switch would not cover even if one existed.
      - SSL_CERT_FILE=/frey-ca.crt
      - REQUESTS_CA_BUNDLE=/frey-ca.crt
      # Hermes's own watchdogs assume a fast provider. The default
      # non-streaming cutoff is 240 s, and prefill of its prompt here is
      # minutes, which is what made a healthy endpoint look broken.
      - HERMES_LOCAL_STREAM_STALE_TIMEOUT={{ h.stale_timeout }}
      - HERMES_STREAM_STALE_TIMEOUT={{ h.stale_timeout }}
      - HERMES_CODEX_TTFB_TIMEOUT_SECONDS={{ h.stale_timeout }}
      - HERMES_API_TIMEOUT={{ h.api_timeout }}
      # The llama-server endpoint is declared in config.yaml as provider
      # `custom`; this is the key that pairs with it. Deliberately NOT
      # OPENAI_BASE_URL/OPENAI_API_KEY: their presence is what makes provider
      # `auto` resolve to openai-api and talk the Responses API to a server
      # that does not implement it.
      - CUSTOM_API_KEY=local
    volumes:
      # HERMES_HOME. Holds sessions, skills and its OIDC session state, so it
      # is persistent and NOT read-only.
      - "{{ h.home_dir }}:/opt/data"
      - "{{ local_ai.stack_dir }}/hermes-config.yaml:/opt/data/config.yaml:ro"
      - "{{ frey.pki_public_dir }}/frey-root-ca.crt:/frey-ca.crt:ro"
      # The notes, in FOUR nested mounts that together say "extend the
      # campaign, change nothing else". Order matters: Docker sorts by path
      # depth, so the shallower read-only mounts are laid down first and the
      # deeper ones override them.
      #
      #   the space            read-only   nothing outside the campaign
      #   Campaigns/Pirate     WRITABLE    new pages and edits land here
      #   .../Templates        read-only   the shape every page copies
      #   .../Rules            read-only   where this model contradicts itself
      #
      # This is the boundary, and it is a mount flag rather than a prompt
      # rule, so no amount of persuasion reaches past it. Strictly stronger
      # than the campaign assistant's equivalent, which refuses those two
      # directories in its own Python - §3 of docs/LOCAL_AI_AGENT_PLAN.md
      # asks for exactly this difference.
      #
      # Hermes runs as SilverBullet's uid (see h.uid), so pages it writes stay
      # editable in SilverBullet. git is the backstop: frey-notes-commit.timer
      # commits the space on a schedule, so a bad edit is recoverable.
      - "{{ frey.notes_data_dir }}/spaces/notes:{{ h.notes_mount }}:ro"
      - "{{ frey.notes_data_dir }}/spaces/notes/{{ h.notes_write_root }}:{{ h.notes_mount }}/{{ h.notes_write_root }}"
{% for sub in h.notes_readonly_subdirs %}
      - "{{ frey.notes_data_dir }}/spaces/notes/{{ h.notes_write_root }}/{{ sub }}:{{ h.notes_mount }}/{{ h.notes_write_root }}/{{ sub }}:ro"
{% endfor %}
    networks:
      # Both, and each for one reason:
      #   ai_private   reaches the model, and is internal so it has no egress
      #   proxy        lets Traefik route hermes.{{ frey.service_domain }} here, and lets the
      #                OIDC back channel reach Authelia by the HTTPS name on
      #                the Frey certificate. Traefik carries a network alias
      #                for every identity_hostnames entry, which is why that
      #                name resolves at all on a Docker bridge - the host's
      #                dnsmasq is bound to the AP radio and ignores queries
      #                arriving over one.
      - ai_private
      - {{ frey.proxy_network }}
    cpus: {{ h.cpus }}
    mem_limit: {{ h.mem_limit }}
    security_opt: [no-new-privileges:true]
{% endif %}
{% if local_ai.chat.enabled | bool %}
{% set w = local_ai.chat %}
  chat:
    profiles: [chat]
    image: {{ w.image }}
    container_name: {{ w.container_name }}
    restart: unless-stopped
    environment:
      - TZ={{ frey.timezone }}

      # THIS FILE IS THE CONFIGURATION, which is not Open WebUI's default.
      # Most of its settings are PersistentConfig: the environment seeds the
      # database on first launch and the database wins ever after, so editing
      # a variable here silently does nothing. That cost real time on
      # 2026-11-20 - RAG_EMBEDDING_ENGINE below was ignored and the container
      # kept throwing IncompleteSnapshotError for a model it should no longer
      # have wanted.
      #
      # false makes the environment authoritative on every boot, which is
      # also the only setting consistent with the rest of Frey: Ansible
      # generates the config and reverts anything edited underneath it. The
      # trade is that admin-UI changes to these keys do not stick - put them
      # in this template instead.
      - ENABLE_PERSISTENT_CONFIG=false

      # Talks to llama-server directly over ai_private, NOT through the
      # authenticated gateway: it is a container, and forward auth would
      # answer it with a login page instead of JSON.
      - OPENAI_API_BASE_URL=http://model:8080/v1
      # llama-server needs no key, but Open WebUI will not use the endpoint
      # with an empty one.
      - OPENAI_API_KEY=local
      # There is no Ollama here. Left on, it probes a host that does not
      # exist on every page load.
      - ENABLE_OLLAMA_API=false

      # LOGIN COMES FROM AUTHELIA, via the header the forward-auth middleware
      # already adds (Remote-Email is in authResponseHeaders in
      # roles/identity/templates/traefik-authelia.yml.j2). Open WebUI
      # auto-registers and logs in from it, so Frey gains no second password
      # and no second user list.
      #
      # Traefik OVERWRITES these headers from Authelia's response, so a
      # client cannot spoof them through the proxy. What it does mean is that
      # anything already on {{ frey.proxy_network }} could set them by
      # talking to this container directly - true of every forward-auth
      # service in Frey, and the reason this network is not shared outward.
      - WEBUI_AUTH_TRUSTED_EMAIL_HEADER=Remote-Email
      - WEBUI_AUTH_TRUSTED_NAME_HEADER=Remote-Name
      # ON, and it has to be. With it false Open WebUI cannot complete
      # ONBOARDING: /api/config reports `"onboarding": true` until an admin
      # exists, the trusted header does NOT create that first admin, and
      # /api/v1/auths/signup answers 403 - so there is no path to a first
      # account at all and every request stays 401. Verified here 2026-11-20
      # by walking into exactly that dead end.
      #
      # Leaving it on is acceptable because it is not the gate: nothing
      # reaches this container through Traefik without an Authelia session,
      # and with the trusted header present Open WebUI logs you in
      # automatically, so the form is not normally even rendered.
      - ENABLE_LOGIN_FORM=true

      # SIGNUP MUST BE ON, which reads wrong until you see what gates it.
      # Trusted-header auth REGISTERS the user named in the header, and with
      # signup disabled it cannot - so with an empty user table every request
      # answered 401 "Not authenticated" even with a correct Remote-Email
      # (verified here 2026-11-20, users: 0; upstream issue #16193).
      #
      # Authelia is the gate, not this setting: nothing reaches this container
      # through Traefik without a session, and access is already restricted to
      # identity_services.local_ai.groups (frey_admins, notes). So "signup"
      # here means "accept whoever Authelia already vouched for", which is the
      # behaviour wanted.
      - ENABLE_SIGNUP=true
      # The FIRST account becomes admin regardless; without this the second
      # and later ones land in `pending` and silently cannot use anything
      # until approved in a UI nobody is watching.
      - DEFAULT_USER_ROLE=user
      - WEBUI_URL=https://{{ local_ai.chat_host }}.{{ frey.service_domain }}

      # NO LOCAL EMBEDDING MODEL. This is the important line on this host.
      #
      # Open WebUI's default RAG engine is SentenceTransformers, and on
      # startup it does not fetch "a model" - it runs `Fetching 30 files` and
      # pulls the WHOLE repo, ONNX and OpenVINO variants included, hundreds of
      # MB. Measured here 2026-11-20 on campground WiFi: it blocked startup
      # for over 20 minutes, the container sat `unhealthy` and refused
      # connections the entire time, and a restart began the same download
      # again. That is the Immich trap in a new costume.
      #
      # Pointing the engine at an OpenAI-compatible URL means no local model
      # is ever instantiated or downloaded, so startup is immediate and
      # offline-safe from the first boot. The cost is deliberate and small
      # here: document upload / RAG will not work, because llama-server is
      # not started with --embeddings. Chat, conversations and the Thinking
      # block - the reasons this exists - need none of it.
      - RAG_EMBEDDING_ENGINE=openai
      - RAG_OPENAI_API_BASE_URL=http://model:8080/v1
      - RAG_OPENAI_API_KEY=local

      # Now safe on a FRESH install too, because nothing is waiting on a
      # download: no update checks, no model fetches, no startup that depends
      # on an uplink.
      - OFFLINE_MODE={{ 'true' if w.offline | bool else 'false' }}
      - HF_HUB_OFFLINE={{ '1' if w.offline | bool else '0' }}
    volumes:
      - "{{ w.data_dir }}:/app/backend/data"
    networks:
      # ai_private reaches the model. The proxy network is what Traefik
      # publishes it on, and is also how it reached Hugging Face for the one
      # embedding-model download that OFFLINE_MODE then makes unnecessary.
      - ai_private
      - {{ frey.proxy_network }}
    cpus: {{ w.cpus }}
    mem_limit: {{ w.mem_limit }}
    security_opt: [no-new-privileges:true]
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network={{ frey.proxy_network }}"
      - "traefik.http.services.openwebui.loadbalancer.server.port={{ w.port }}"
      - "traefik.http.routers.openwebui.rule=Host(`{{ local_ai.chat_host }}.{{ frey.service_domain }}`)"
      - "traefik.http.routers.openwebui.entrypoints=websecure"
      - "traefik.http.routers.openwebui.tls=true"
      - "traefik.http.routers.openwebui.middlewares=secure-headers@file,authelia@file"
      - "traefik.http.routers.openwebui.service=openwebui"
      - "traefik.http.routers.openwebui-legacy.rule=Host(`{{ local_ai.chat_host }}.{{ frey.local_domain }}`)"
      - "traefik.http.routers.openwebui-legacy.entrypoints=websecure"
      - "traefik.http.routers.openwebui-legacy.tls=true"
      - "traefik.http.routers.openwebui-legacy.middlewares=to-canonical@file"
      - "traefik.http.routers.openwebui-legacy.service=openwebui"
      # Plain HTTP redirects rather than serving: this is behind forward auth,
      # and Authelia's session cookie is Secure, so an HTTP origin would log
      # in and then loop.
      - "traefik.http.routers.openwebui-http.rule=Host(`{{ local_ai.chat_host }}.{{ frey.service_domain }}`) || Host(`{{ local_ai.chat_host }}.{{ frey.local_domain }}`)"
      - "traefik.http.routers.openwebui-http.entrypoints=web"
      - "traefik.http.routers.openwebui-http.middlewares=to-canonical@file"
      - "traefik.http.routers.openwebui-http.service=openwebui"
{% endif %}
networks:
  {{ frey.proxy_network }}:
    external: true
  ai_private:
    internal: true
{% if local_ai.observer.enabled | bool %}
  {{ frey.ai_observe_network }}:
    external: true
{% endif %}
