# Managed by Ansible. Do not edit on the Pi.
#
# Two containers on purpose. The gateway speaks to Frey's authenticated proxy;
# the model sits on an internal-only network with no egress, no Docker socket,
# no credentials and nothing mounted but its own weights, read-only. Widening
# what the assistant can answer must never widen what it can reach.
{% set m = local_ai.models[local_ai.default_model] %}
services:
  gateway:
    image: {{ local_ai.gateway_image }}
    container_name: frey-local-ai-gateway
    restart: unless-stopped
    user: "65534:65534"
    command:
      - --entrypoints.web.address=:8080
      - --providers.file.filename=/etc/traefik/route.yml
      - --accesslog=false
    volumes:
      - "{{ local_ai.stack_dir }}/route.yml:/etc/traefik/route.yml:ro"
    networks:
      - {{ frey.proxy_network }}
      - ai_private
    mem_limit: 128m
    security_opt: [no-new-privileges:true]
    cap_drop: [ALL]
    read_only: true
    tmpfs: [/tmp]
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network={{ frey.proxy_network }}"
      - "traefik.http.services.local-ai.loadbalancer.server.port=8080"
      - "traefik.http.routers.local-ai.rule=Host(`{{ local_ai.host }}.{{ frey.service_domain }}`)"
      - "traefik.http.routers.local-ai.entrypoints=websecure"
      - "traefik.http.routers.local-ai.tls=true"
      - "traefik.http.routers.local-ai.middlewares=secure-headers@file,authelia@file"
      - "traefik.http.routers.local-ai-legacy.rule=Host(`{{ local_ai.host }}.{{ frey.local_domain }}`)"
      - "traefik.http.routers.local-ai-legacy.entrypoints=websecure"
      - "traefik.http.routers.local-ai-legacy.tls=true"
      - "traefik.http.routers.local-ai-legacy.middlewares=to-canonical@file"
      - "traefik.http.routers.local-ai-legacy.service=local-ai"
      - "traefik.http.routers.local-ai-http.rule=Host(`{{ local_ai.host }}.{{ frey.service_domain }}`) || Host(`{{ local_ai.host }}.{{ frey.local_domain }}`)"
      - "traefik.http.routers.local-ai-http.entrypoints=web"
      - "traefik.http.routers.local-ai-http.middlewares=to-canonical@file"
      - "traefik.http.routers.local-ai-http.service=local-ai"
{% if local_ai.campaign.enabled | bool %}
      # The assistant's own hostname, same gateway, same auth. route.yml
      # dispatches on Host so this reaches the assistant rather than the model.
      - "traefik.http.routers.campaign.rule=Host(`{{ local_ai.campaign_host }}.{{ frey.service_domain }}`)"
      - "traefik.http.routers.campaign.entrypoints=websecure"
      - "traefik.http.routers.campaign.tls=true"
      - "traefik.http.routers.campaign.middlewares=secure-headers@file,authelia@file"
      - "traefik.http.routers.campaign.service=local-ai"
      - "traefik.http.routers.campaign-legacy.rule=Host(`{{ local_ai.campaign_host }}.{{ frey.local_domain }}`)"
      - "traefik.http.routers.campaign-legacy.entrypoints=websecure"
      - "traefik.http.routers.campaign-legacy.tls=true"
      - "traefik.http.routers.campaign-legacy.middlewares=to-canonical@file"
      - "traefik.http.routers.campaign-legacy.service=local-ai"
      - "traefik.http.routers.campaign-http.rule=Host(`{{ local_ai.campaign_host }}.{{ frey.service_domain }}`) || Host(`{{ local_ai.campaign_host }}.{{ frey.local_domain }}`)"
      - "traefik.http.routers.campaign-http.entrypoints=web"
      - "traefik.http.routers.campaign-http.middlewares=to-canonical@file"
      - "traefik.http.routers.campaign-http.service=local-ai"
{% endif %}
{% if local_ai.hermes.enabled | bool %}
      # Hermes's hostname, same gateway, and DELIBERATELY WITHOUT
      # authelia@file. Hermes is an OIDC relying party that runs its own login
      # against Authelia, so forward auth here would mean authenticating twice
      # for one service. Access is still restricted to
      # identity_services.hermes.groups, which Authelia applies before it
      # issues a token - taking the middleware off does not widen who gets in.
      #
      # secure-headers stays: that is transport hardening, not authentication.
      - "traefik.http.routers.hermes.rule=Host(`{{ local_ai.hermes_host }}.{{ frey.service_domain }}`)"
      - "traefik.http.routers.hermes.entrypoints=websecure"
      - "traefik.http.routers.hermes.tls=true"
      - "traefik.http.routers.hermes.middlewares=secure-headers@file"
      - "traefik.http.routers.hermes.service=local-ai"
      - "traefik.http.routers.hermes-legacy.rule=Host(`{{ local_ai.hermes_host }}.{{ frey.local_domain }}`)"
      - "traefik.http.routers.hermes-legacy.entrypoints=websecure"
      - "traefik.http.routers.hermes-legacy.tls=true"
      - "traefik.http.routers.hermes-legacy.middlewares=to-canonical@file"
      - "traefik.http.routers.hermes-legacy.service=local-ai"
      - "traefik.http.routers.hermes-http.rule=Host(`{{ local_ai.hermes_host }}.{{ frey.service_domain }}`) || Host(`{{ local_ai.hermes_host }}.{{ frey.local_domain }}`)"
      - "traefik.http.routers.hermes-http.entrypoints=web"
      - "traefik.http.routers.hermes-http.middlewares=to-canonical@file"
      - "traefik.http.routers.hermes-http.service=local-ai"
{% endif %}
  model:
    profiles: [model]
    image: {{ local_ai.image }}
    container_name: frey-local-ai-model
    restart: unless-stopped
    user: "65534:65534"
    command:
      - "-m"
      - "/models/{{ m.file }}"
{% if m.mmproj_file is defined %}
      - "--mmproj"
      - "/models/{{ m.mmproj_file }}"
{% endif %}
      - "--host"
      - "0.0.0.0"
      - "--port"
      - "8080"
      - "--threads"
      - "{{ m.threads }}"
      - "--ctx-size"
      - "{{ m.ctx }}"
{% if m.parallel_slots is defined %}
      - "--parallel"
      - "{{ m.parallel_slots }}"
{% endif %}
      - "--cache-reuse"
      - "{{ m.cache_reuse }}"
{% if m.cache_type_k is defined %}
      - "--cache-type-k"
      - "{{ m.cache_type_k }}"
{% endif %}
{% if m.cache_type_v is defined %}
      - "--cache-type-v"
      - "{{ m.cache_type_v }}"
{% endif %}
      - "-fa"
      - "{{ m.flash_attn }}"
      - "--temp"
      - "{{ m.temperature }}"
      - "--top-p"
      - "{{ m.top_p }}"
      - "--top-k"
      - "{{ m.top_k }}"
      - "--min-p"
      - "{{ m.min_p }}"
      - "--presence-penalty"
      - "{{ m.presence_penalty }}"
      - "--jinja"
      # --reasoning, not --chat-template-kwargs: b12019 warns at startup that
      # setting enable_thinking through chat-template-kwargs is deprecated.
      # This flag sets the same template variable internally.
      - "--reasoning"
      - "{{ 'on' if m.enable_thinking | bool else 'off' }}"
    volumes:
      - "{{ local_ai.model_dir }}:/models:ro"
    networks:
      - ai_private
    cpus: {{ m.cpus }}
    mem_limit: {{ m.mem_limit }}
    security_opt: [no-new-privileges:true]
    cap_drop: [ALL]
    read_only: true
    tmpfs: [/tmp]
{% if local_ai.observer.enabled | bool %}
{% set o = local_ai.observer %}
  observer:
    profiles: [observer]
    image: {{ o.image }}
    container_name: {{ o.container_name }}
    restart: unless-stopped
    user: "{{ o.uid }}:{{ o.gid }}"
    command: ["python3", "-u", "{{ o.script_path }}"]
    environment:
      - TZ={{ frey.timezone }}
      - PYTHONDONTWRITEBYTECODE=1
      - FREY_NODE={{ frey.node_name }}
      - OBSERVER_LOG_LEVEL={{ o.log_level }}
      - PROM_URL=http://prometheus:9090
      - LOKI_URL=http://loki:3100
      - ALERTMANAGER_URL=http://alertmanager:9093
      - RELAY_URL=http://alert-relay:8080
      - MODEL_URL=http://model:8080
      - DRAFTS_DIR=/drafts
      - TEXTFILE_DIR=/textfile
      - NOTES_DIR=/notes
      - POLL_SECONDS={{ o.poll_seconds }}
      - DAILY_HOUR={{ o.daily_hour }}
      - MAX_TOKENS={{ o.max_tokens }}
      - MODEL_TIMEOUT={{ o.model_timeout }}
      - NOTIFY_SEVERITY={{ o.notify_severity }}
      - RUNBOOK_PAGE={{ o.runbook_page }}
    volumes:
      # Read broadly, write to an explicit allowlist. Only two paths are
      # read-write: the drafts directory and the broker's request queue.
      # Everything else is :ro, and credential material is not mounted at all
      # - so the denial is ENOENT rather than EACCES, and no code of ours has
      # to be correct for that to hold.
      - "{{ o.drafts_dir }}:/drafts"
{% if local_ai.broker.enabled | bool %}
      # The only channel to anything privileged. Write a request here; read
      # the answer from a directory that is read-only to this container, so
      # the agent cannot forge its own response.
      - "{{ local_ai.broker.req_dir }}:/broker/req"
      - "{{ local_ai.broker.res_dir }}:/broker/res:ro"
{% endif %}
      - "{{ local_ai.stack_dir }}/observer.py:{{ o.script_path }}:ro"
{% for path in local_ai_observer_read_paths | default([]) %}
      - "{{ path.src }}:{{ path.dest }}:ro"
{% endfor %}
    networks:
      # Both internal. The observer therefore has no route to the internet,
      # which is what makes its broad read access safe: there is nowhere to
      # send anything, and its only output is a file you read.
      - ai_private
      - {{ frey.ai_observe_network }}
    cpus: {{ o.cpus }}
    mem_limit: {{ o.mem_limit }}
    security_opt: [no-new-privileges:true]
    cap_drop: [ALL]
    read_only: true
    tmpfs: [/tmp]
{% endif %}
{% if local_ai.campaign.enabled | bool %}
{% set c = local_ai.campaign %}
  campaign:
    profiles: [campaign]
    image: {{ c.image }}
    container_name: {{ c.container_name }}
    restart: unless-stopped
    user: "{{ c.uid }}:{{ c.gid }}"
{% if local_ai.broker.enabled | bool %}
    # Runs as SilverBullet's uid so it can write notes, plus the observer's
    # group so it can write into the broker's request queue, which is
    # group-owned by that gid at 0770.
    group_add: ["{{ local_ai.observer.gid }}"]
{% endif %}
    command: ["python3", "-u", "{{ c.script_path }}"]
    environment:
      - TZ={{ frey.timezone }}
      - PYTHONDONTWRITEBYTECODE=1
      - CAMPAIGN_LOG_LEVEL={{ c.log_level }}
      - MODEL_URL=http://model:8080
      - MODEL_NAME=/models/{{ m.file }}
      - CAMPAIGN_SPACE=/notes
      - CAMPAIGN_ROOT={{ c.root }}
      - CAMPAIGN_CHAT_PAGE={{ c.chat_page }}
      - CAMPAIGN_READONLY={{ c.readonly_subdirs | join(',') }}
      - CAMPAIGN_POLL_SECONDS={{ c.poll_seconds }}
      - CAMPAIGN_MODEL_TIMEOUT={{ c.model_timeout }}
      - CAMPAIGN_MAX_TOKENS={{ c.max_tokens }}
      - CAMPAIGN_MAX_STEPS={{ c.max_steps }}
      - CAMPAIGN_TOOL_RESULT_BUDGET={{ c.tool_result_budget }}
      - CAMPAIGN_PORT={{ c.port }}
{% if local_ai.broker.enabled | bool %}
      - BROKER_REQ_DIR=/broker/req
      - BROKER_RES_DIR=/broker/res
{% endif %}
    volumes:
      # Nested mounts on purpose, so the WRITE scope is enforced by the mount
      # table rather than only by the agent's own path checks:
      #   the space itself is read-only,
      #   the campaign subtree is read-write,
      #   .git is read-write because committing needs it and it lives at the
      #   space root - without this nesting, enabling commits would have meant
      #   mounting the entire space read-write.
      - "{{ frey.notes_data_dir }}/spaces/notes:/notes:ro"
      - "{{ frey.notes_data_dir }}/spaces/notes/{{ c.root }}:/notes/{{ c.root }}"
      - "{{ frey.notes_data_dir }}/spaces/notes/.git:/notes/.git"
      - "{{ local_ai.stack_dir }}/campaign.py:{{ c.script_path }}:ro"
{% if local_ai.broker.enabled | bool %}
      # The only channel to anything privileged, and read verbs only. Requests
      # go in; answers come from a directory that is read-only here, so the
      # assistant cannot forge a reply to itself.
      - "{{ local_ai.broker.req_dir }}:/broker/req"
      - "{{ local_ai.broker.res_dir }}:/broker/res:ro"
{% endif %}
    networks:
      # ai_private only: it needs the model and nothing else. internal, so no
      # egress - and it has no broker access and no system verbs at all.
      - ai_private
    cpus: {{ c.cpus }}
    mem_limit: {{ c.mem_limit }}
    security_opt: [no-new-privileges:true]
    cap_drop: [ALL]
    read_only: true
    tmpfs: [/tmp]
{% endif %}
{% if local_ai.hermes.enabled | bool %}
{% set h = local_ai.hermes %}
  hermes:
    profiles: [hermes]
    image: {{ h.image }}
    container_name: {{ h.container_name }}
    restart: unless-stopped
    # NO `user:` here, and no `init: true` either - both were tried and both
    # are wrong, in ways the image tells you about only after it fails:
    #
    #   `user:` makes s6-overlay's preinit die in a restart loop, because it
    #   refuses to continue unless /run belongs to the container uid and it
    #   has no privileges left to fix it ("/run belongs to uid 0 instead of
    #   10003 ... and we're lacking the privileges to fix it", exit 100). The
    #   image's own message is explicit: "DON'T use --user", pass HERMES_UID
    #   and HERMES_GID instead and it remaps its user at boot.
    #
    #   `init: true` hides that crash rather than fixing it: with an init
    #   process as PID 1, s6 notices it is not PID 1 and skips itself - so
    #   nothing drops privileges and the agent runs as ROOT. That is how the
    #   one-shot measurements were taken, which is fine for a measurement and
    #   not fine for a service.
    #
    # So: start as root, let s6 fix /run and drop to the uid below.
    # `dashboard`, not `chat`: this is the long-running web UI. --skip-build
    # is required and safe - the image ships a prebuilt bundle at
    # hermes_cli/web_dist, so nothing calls npm at runtime and nothing needs
    # an uplink. --no-open because there is no browser on the Pi.
    #
    # 0.0.0.0 inside the container is what lets Traefik reach it. Hermes
    # DEMANDS an auth provider for any non-loopback bind - its --insecure flag
    # became a no-op in the June 2026 hardening - which is satisfied by the
    # OIDC block in config.yaml, not by a password.
    command:
      - dashboard
      - "--host"
      - "0.0.0.0"
      - "--port"
      - "{{ h.port }}"
      - "--skip-build"
      - "--no-open"
    environment:
      - TZ={{ frey.timezone }}
      # The supported way to own the data volume as a non-root uid: the image
      # remaps its `hermes` user to these at boot and chowns /opt/data to
      # match. PUID/PGID are accepted aliases.
      - HERMES_UID={{ h.uid }}
      - HERMES_GID={{ h.gid }}
      # httpx 0.28.1 builds its SSL context with ssl.create_default_context(),
      # which reads this - verified in the image against
      # https://{{ identity_hosts.auth }}.{{ frey.service_domain }}, where OIDC discovery
      # returned 200 and the expected issuer. Without it the back channel
      # fails inside the OIDC library, which an app-level "trust everything"
      # switch would not cover even if one existed.
      - SSL_CERT_FILE=/frey-ca.crt
      - REQUESTS_CA_BUNDLE=/frey-ca.crt
      # Hermes's own watchdogs assume a fast provider. The default
      # non-streaming cutoff is 240 s, and prefill of its prompt here is
      # minutes, which is what made a healthy endpoint look broken.
      - HERMES_LOCAL_STREAM_STALE_TIMEOUT={{ h.stale_timeout }}
      - HERMES_STREAM_STALE_TIMEOUT={{ h.stale_timeout }}
      - HERMES_CODEX_TTFB_TIMEOUT_SECONDS={{ h.stale_timeout }}
      - HERMES_API_TIMEOUT={{ h.api_timeout }}
      # The llama-server endpoint is declared in config.yaml as provider
      # `custom`; this is the key that pairs with it. Deliberately NOT
      # OPENAI_BASE_URL/OPENAI_API_KEY: their presence is what makes provider
      # `auto` resolve to openai-api and talk the Responses API to a server
      # that does not implement it.
      - CUSTOM_API_KEY=local
    volumes:
      # HERMES_HOME. Holds sessions, skills and its OIDC session state, so it
      # is persistent and NOT read-only.
      - "{{ h.home_dir }}:/opt/data"
      - "{{ local_ai.stack_dir }}/hermes-config.yaml:/opt/data/config.yaml:ro"
      - "{{ frey.pki_public_dir }}/frey-root-ca.crt:/frey-ca.crt:ro"
    networks:
      # Both, and each for one reason:
      #   ai_private   reaches the model, and is internal so it has no egress
      #   proxy        lets Traefik route hermes.{{ frey.service_domain }} here, and lets the
      #                OIDC back channel reach Authelia by the HTTPS name on
      #                the Frey certificate. Traefik carries a network alias
      #                for every identity_hostnames entry, which is why that
      #                name resolves at all on a Docker bridge - the host's
      #                dnsmasq is bound to the AP radio and ignores queries
      #                arriving over one.
      - ai_private
      - {{ frey.proxy_network }}
    cpus: {{ h.cpus }}
    mem_limit: {{ h.mem_limit }}
    security_opt: [no-new-privileges:true]
{% endif %}
networks:
  {{ frey.proxy_network }}:
    external: true
  ai_private:
    internal: true
{% if local_ai.observer.enabled | bool %}
  {{ frey.ai_observe_network }}:
    external: true
{% endif %}
