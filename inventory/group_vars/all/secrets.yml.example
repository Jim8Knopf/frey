---
# Example only. This file is not loaded by Ansible because it does not end in .yml.
# Create group_vars/all/secrets.yml with ansible-vault when you need a Wi-Fi password.

vault_public_wifi_password: "replace-me"

# ------------------------------------------------------------------------------
# MEDIA SECRETS - OPTIONAL
#
# The media modules do NOT need anything here. API keys, the qBittorrent WebUI
# password, the Jellyfin admin password and Jellystat's secrets are generated
# on first deploy and persisted on the Pi at
# /opt/frey/appdata/.media-keys.json (mode 0600).
#
# A rebuild from scratch generates fresh values, which is harmless: the same
# run re-applies every connection that uses them.
#
# Define them here only if you want them reproducible from the repo - for
# instance to keep a client's saved API key working across a rebuild. Vault
# values always win over generated ones, and partial overrides are fine: list
# only the keys you care about.
# ------------------------------------------------------------------------------
# vault_media_api_keys:
#   prowlarr: "32 hex characters"
#   sonarr: "32 hex characters"
#   radarr: "32 hex characters"
#   lidarr: "32 hex characters"
#   chaptarr: "32 hex characters"
#   bazarr: "32 hex characters"
#   qbittorrent_password: "a password you choose"
#   jellyfin_admin_password: "a password you choose"
#   jellystat_postgres_password: "32 hex characters"
#   jellystat_jwt_secret: "32 hex characters"
#
# Generate one:
#   openssl rand -hex 16
