---
# Example only. This file is not loaded by Ansible because it does not end in .yml.
# Create group_vars/all/secrets.yml with ansible-vault when you need a Wi-Fi password.

vault_public_wifi_password: "replace-me"

# ------------------------------------------------------------------------------
# MEDIA SECRETS - OPTIONAL
#
# The media modules do NOT need anything here. API keys, the qBittorrent WebUI
# password, the Jellyfin admin password and Jellystat's secrets are generated
# on first deploy and persisted on the Pi at
# /opt/frey/appdata/.media-keys.json (mode 0600).
#
# A rebuild from scratch generates fresh values, which is harmless: the same
# run re-applies every connection that uses them.
#
# Define them here only if you want them reproducible from the repo - for
# instance to keep a client's saved API key working across a rebuild. Vault
# values always win over generated ones, and partial overrides are fine: list
# only the keys you care about.
# ------------------------------------------------------------------------------
# vault_media_api_keys:
#   prowlarr: "32 hex characters"
#   sonarr: "32 hex characters"
#   radarr: "32 hex characters"
#   lidarr: "32 hex characters"
#   chaptarr: "32 hex characters"
#   bazarr: "32 hex characters"
#   qbittorrent_password: "a password you choose"
#   # Both halves of qBittorrent's WebUI login live here. The username is not
#   # generated and is not a secret in itself, but it is half of a credential,
#   # so it belongs with the other half rather than in a role default. Omit it
#   # and it stays 'admin'.
#   #
#   # Setting it here is the ONLY correct way to change it: one deploy moves
#   # qBittorrent, the four *arr download clients and the download-gate script
#   # together. Changing it in qBittorrent's web UI moves only qBittorrent, and
#   # the *arrs then 401 on every poll and report "all download clients
#   # unavailable".
#   qbittorrent_username: "media_admin"
#   jellyfin_admin_password: "a password you choose"
#   jellystat_postgres_password: "32 hex characters"
#   jellystat_jwt_secret: "32 hex characters"
#
# Generate one:
#   openssl rand -hex 16

# ------------------------------------------------------------------------------
# MONITORING SECRETS - OPTIONAL
#
# The monitoring module does NOT need anything here. The ntfy topic and the
# Grafana local admin password are generated on first deploy and persisted on
# the Pi at /opt/frey/appdata/monitoring/.monitoring-keys.json (mode 0600).
# The topic is printed once, at the end of that first run, so you can
# subscribe your phone to it.
#
# Define them here only if you want them reproducible from the repo - for
# instance so that a rebuilt Pi keeps the topic your phone is already
# subscribed to, rather than generating a new one you have to re-add.
#
# THE TOPIC IS EFFECTIVELY A PASSWORD. ntfy.sh is a public relay: anyone who
# knows the topic name can read your alerts and send you fake ones. Make it
# long and random, not "frey-alerts".
#
#   vault_ntfy_topic: "frey-<24 random hex characters>"
#
# Generate one:
#   echo "frey-$(openssl rand -hex 12)"
#
# Only needed for a private or self-hosted ntfy instance that requires auth:
#   vault_ntfy_token: "tk_..."
#
# Partial overrides are fine - vault values always win over generated ones:
#   vault_monitoring_secrets:
#     grafana_admin_password: "a password you choose"
