#!/usr/bin/env bash
#
# Post-commit: say something only when a vault file is sitting decrypted.
#
# The old version congratulated you on every commit for having an encrypted
# secrets.yml, which is noise - that is the normal state. The useful moment is
# the opposite one: a vault file left decrypted after you finished editing it.
set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)" || exit 0
cd "$REPO_ROOT" || exit 0

CIPHERTEXT_MARKER='$ANSIBLE_VAULT'

git ls-files \
  | grep -E '(^|/)(secrets|vault)\.ya?ml$|secrets\.ya?ml$' \
  | while IFS= read -r file; do
      [ -f "$file" ] || continue
      if ! head -c 20 "$file" 2>/dev/null | grep -qF "$CIPHERTEXT_MARKER"; then
        printf '\033[33m! %s is decrypted.\033[0m Re-encrypt before it gets staged:\n' "$file"
        printf '   ansible-vault encrypt %s --vault-password-file .vault_pass\n' "$file"
      fi
    done

exit 0
